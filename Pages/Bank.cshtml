@page
@model Amadban.Pages.BankModel
@{
    ViewData["Title"] = "ثبت چک و چاپ بانکی";
}
<header class="hero"><div class="hero-main"><span class="hero-icon"><img src="/icon3d/card.webp" width="82" height="82" alt=""></span><div><div class="eyebrow">مدارک بانکی</div><h1>ثبت چک و فرم صیاد</h1><p>چک‌ها را ثبت کنید و فرم رسمی عملیات چک در سامانه صیاد را روی A4 چاپ کنید.</p></div></div></header>
@if (Model.Message is not null) { <p class="notice" role="status">@Model.Message</p> }
<section class="card">
    <h2>اطلاعات چک</h2>
    <form method="post" class="filters">
        <label>شناسه صیاد<input name="sayad" inputmode="numeric" maxlength="16" required dir="ltr"></label>
        <label>شماره حساب<input name="account" maxlength="50" required dir="ltr"></label>
        <label>بانک<input name="bank" maxlength="80" required></label>
        <label>شعبه<input name="branch" maxlength="80" required></label>
        <label>تاریخ چک<input name="date" value="@Persian.Date(Persian.Today)" required dir="ltr"></label>
        <label>مبلغ (ریال)<input name="amount" inputmode="numeric" required></label>
        <label>در وجه<input name="recipient" maxlength="150" required></label>
        <label>کد ملی / شناسه ملی ذی‌نفع<input name="recipientIdentity" maxlength="30" inputmode="numeric" dir="ltr"></label>
        <label>پیش‌پرداخت مرتبط (اختیاری)<select name="prepayment"><option value="0">بدون پیش‌پرداخت</option>
            @foreach (var item in Model.BankPrepayments) { <option value="@item.Number">شماره @item.Number · @item.Vendor</option> }
        </select></label>
        <button type="submit" class="button primary">ثبت مشخصات چک</button>
    </form>
</section>
<section class="card">
    <h2>چک‌های ثبت‌شده</h2>
    <form method="get" asp-page="/PrintBank" asp-antiforgery="false">
        <div class="filters"><label>نوع عملیات بانکی<select name="operation"><option>ثبت</option><option>تأیید</option><option>انتقال</option><option>ابطال</option><option>لغو ثبت</option><option>رفع انسداد</option></select></label></div>
        <div class="table-wrap"><table>
            <thead><tr><th>انتخاب</th><th>شناسه صیاد</th><th>ذی‌نفع</th><th>بانک</th><th>پیش‌پرداخت</th><th>مبلغ ریال</th></tr></thead>
            <tbody>
            @foreach (var c in Model.Checks.Take(25))
            {
                <tr><td><input type="checkbox" name="ids" value="@c.Id" aria-label="انتخاب چک @c.Sayad"></td><td>@c.Sayad</td>
                    <td>@c.Recipient</td><td>@c.Bank</td><td>@(c.Prepayment?.ToString() ?? "—")</td><td>@Persian.Money(c.Amount)</td></tr>
            }
            </tbody>
        </table></div>
        @if (Model.Checks.Count > 0) { <button class="button" type="submit">چاپ فرم صیاد برای چک‌های انتخابی</button> }
    </form>
    <nav class="pagination" aria-label="صفحه چک‌ها">
        @if (Model.P > 1) { <a class="button" asp-route-P="@(Model.P-1)">قبلی</a> }
        @if (Model.Checks.Count > 25) { <a class="button" asp-route-P="@(Model.P+1)">بعدی</a> }
    </nav>
    <details><summary>اصلاح مشخصات چک‌های ثبت‌شده</summary>
        @foreach (var c in Model.Checks.Take(25))
        { <details><summary>صیاد @c.Sayad · @c.Recipient</summary><form method="post" asp-page-handler="Correct" class="fields">
            <input type="hidden" name="id" value="@c.Id">
            <label>صیاد<input name="sayad" value="@c.Sayad" required maxlength="16"></label>
            <label>حساب<input name="account" value="@c.Account" required maxlength="50"></label>
            <label>بانک<input name="bank" value="@c.Bank" required maxlength="80"></label>
            <label>شعبه<input name="branch" value="@c.Branch" required maxlength="80"></label>
            <label>تاریخ<input name="date" value="@Persian.Date(c.Date)" required></label>
            <label>مبلغ ریال<input name="amount" value="@c.Amount" required></label>
            <label>در وجه<input name="recipient" value="@c.Recipient" required maxlength="150"></label>
            <label>کد ملی / شناسه ملی<input name="recipientIdentity" value="@c.RecipientIdentity" maxlength="30" dir="ltr"></label>
            <label>پیش‌پرداخت<select name="prepayment"><option value="0">بدون پیوند</option>
                @foreach (var item in Model.BankPrepayments) { <option value="@item.Number" selected="@(c.Prepayment==item.Number)">@item.Number · @item.Vendor</option> }
            </select></label><button class="button" type="submit">ذخیره اصلاح</button>
        </form></details> }
    </details>
</section>

@if (Model.BankPrepayments.Count > 0)
{
    <section class="card">
        <h2>برگه نیابتی برای مراجعه به بانک</h2>
        <form method="get" asp-page="/PrintForms" asp-antiforgery="false">
            <input type="hidden" name="kind" value="proxy">
            <div class="table-wrap"><table><thead><tr><th>انتخاب</th><th>پیش‌پرداخت</th><th>فروشنده</th><th>وضعیت</th><th>مبلغ</th></tr></thead>
            <tbody>@foreach (var item in Model.BankPrepayments)
            { <tr><td><input type="checkbox" name="ids" value="@item.Number" aria-label="انتخاب پیش‌پرداخت @item.Number"></td>
                <td>@item.Number</td><td>@item.Vendor</td><td>@(item.State == "paid" ? "پرداخت‌شده" : "رزروشده")</td><td>@Persian.Money(item.Amount)</td></tr> }</tbody></table></div>
            <button class="button" type="submit">پیش‌نمایش برگه نیابتی A4</button>
        </form>
    </section>
}
