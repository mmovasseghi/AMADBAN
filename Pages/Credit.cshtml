@page
@model Amadban.Pages.CreditModel
@{
    ViewData["Title"] = Model.Invoice is not null || Model.Payment is not null ? "پیش‌پرداخت" : "اعتبار و پیش‌پرداخت";
}
<header class="hero"><h1>@ViewData["Title"]</h1><a class="button" asp-page="/Credit">کدهای اعتباری</a></header>
@if (Model.Message is not null) { <p class="notice" role="status">@Model.Message</p> }
@if (Model.Payment is { } payment)
{
    <section class="card">
        <h2>پیش‌پرداخت @payment.Number · @payment.Vendor</h2>
        <p>کد @payment.Code · @payment.CodeTitle · @Persian.Money(payment.Amount) ریال</p>
        <p>@(payment.State == "paid" ? "پرداخت‌شده" : payment.State == "void" ? "باطل‌شده" : "اعتبار رزرو شده")</p>
        <div class="actions">
            <a class="button" asp-page="/PrintPrepayment" asp-route-number="@payment.Number">چاپ پیش‌پرداخت A4</a>
            @if (payment.Invoice is long id) { <a class="button" asp-page="/Invoices/Detail" asp-route-id="@id">باز کردن سند</a> }
        </div>
        @if (payment.State != "void")
        {
            <form method="post" asp-page-handler="Action" class="filters">
                <input type="hidden" name="number" value="@payment.Number"><input type="hidden" name="invoice" value="@payment.Invoice">
                <label>کد صحیح<select name="code">@foreach (var c in Model.Codes) { <option value="@c.Id" selected="@(c.Id == payment.CodeId)">@c.Code · @c.Title</option> }</select></label>
                <button class="button" name="action" value="code">اصلاح کد</button>
            </form>
            @if (Model.IsAgent && payment.State == "reserved")
            {
                <form method="post" asp-page-handler="Action" class="actions">
                    <input type="hidden" name="number" value="@payment.Number"><input type="hidden" name="invoice" value="@payment.Invoice">
                    @if (payment.Invoice is not null) { <label class="inline"><input type="checkbox" name="proxy" value="true"> پرداخت گروهی در بانک</label> }
                    <button class="button primary" name="action" value="pay">ثبت پرداخت قطعی</button>
                    <button class="button" name="action" value="void">ابطال و آزادکردن اعتبار</button>
                </form>
            }
            @if (Model.IsAgent && payment.Invoice is null)
            {
                <form method="post" asp-page-handler="Link" class="filters">
                    <input type="hidden" name="number" value="@payment.Number">
                    <label>شناسه پرونده خرید<input type="number" name="invoice" min="1" required></label>
                    <button class="button" type="submit">اتصال به پرونده</button>
                </form>
            }
        }
    </section>
}
else if (Model.IsAgent)
{
    <section class="card">
        <h2>@(Model.Invoice is null ? "پیش‌پرداخت بر اساس پیش‌فاکتور" : $"پیش‌پرداخت سند {Model.Invoice.Summary.Document}")</h2>
        <form method="post" asp-page-handler="Reserve" class="filters">
            <input type="hidden" name="invoice" value="@(Model.Invoice?.Summary.Id ?? 0)">
            @if (Model.Invoice is null)
            {
                <label>شماره پیش‌فاکتور<input name="proforma" maxlength="80" required></label>
                <label>فروشنده<input name="vendor" maxlength="180" required></label>
            }
            <label>کد اعتباری<select name="code" required><option value="">انتخاب کنید</option>@foreach (var c in Model.Codes) { <option value="@c.Id">@c.Code · @c.Title · @Persian.Money(c.Available) ریال مانده</option> }</select></label>
            @if (Model.Accounts.Count > 0)
            {
                <label>حساب ثبت‌شده فروشنده<select data-account><option value="">انتخاب حساب</option>@foreach (var a in Model.Accounts) { <option value="@a.Id" data-owner="@a.Owner" data-bank="@a.Bank" data-sheba="@a.Sheba">@a.Bank · @a.Sheba</option> }</select></label>
            }
            <label>نام صاحب حساب<input name="owner" maxlength="140" required></label>
            <label>بانک<input name="bank" maxlength="100" required></label>
            <label>شبا<input name="sheba" dir="ltr" maxlength="32" required></label>
            <label>مبلغ (ریال)<input name="amount" dir="ltr" inputmode="numeric" value="@Model.Invoice?.Summary.Total" required></label>
            <label>شماره مجوز<input name="permit" maxlength="80"></label>
            <label>تاریخ مجوز<input name="permitDate" dir="ltr" maxlength="10"></label>
            <label>مالیات جداگانه درج‌شونده (ریال)<input name="tax" inputmode="numeric"></label>
            <button class="button primary" type="submit">ثبت و رزرو اعتبار</button>
        </form>
        @if (Model.Invoice is not null)
        {
            <form method="post" asp-page-handler="Link" class="filters">
                <input type="hidden" name="invoice" value="@Model.Invoice.Summary.Id">
                <label>شماره پیش‌پرداخت قبلی<input name="number" type="number" min="1" required></label>
                <button class="button" type="submit">اتصال پیش‌پرداخت پیش‌فاکتور</button>
            </form>
        }
    </section>
}
@if (Model.Invoice is null && Model.Payment is null)
{
    @if (Model.Notices.Count > 0)
    {
        <section class="card"><h2>اعلان‌های اعتبار</h2><ul>@foreach (var item in Model.Notices) { <li>@item</li> }</ul></section>
    }
    <section class="card">
        <h2>کدهای اعتباری</h2>
        <form method="post" asp-page-handler="Add" class="filters">
            <label>شماره کد<input name="code" maxlength="40" required></label>
            <label>عنوان<input name="title" maxlength="150" required></label>
            <button class="button" type="submit">افزودن کد</button>
        </form>
        <form method="post" asp-page-handler="Allocate" class="filters">
            <label>مبدأ<select name="from"><option value="0">افزایش از تخصیص جدید</option>@foreach (var c in Model.Codes) { <option value="@c.Id">@c.Code · @c.Title</option> }</select></label>
            <label>مقصد<select name="to" required><option value="">انتخاب کنید</option>@foreach (var c in Model.Codes) { <option value="@c.Id">@c.Code · @c.Title</option> }</select></label>
            <label>مبلغ (ریال)<input name="amount" inputmode="numeric" required></label>
            <button class="button primary" type="submit">ثبت افزایش یا انتقال</button>
        </form>
        <div class="table-wrap"><table>
            <thead><tr><th>کد و عنوان</th><th>تخصیص</th><th>رزرو</th><th>مصرف قطعی</th><th>مانده قابل استفاده</th></tr></thead>
            <tbody>@foreach (var c in Model.Codes)
            { <tr><td>@c.Code · @c.Title</td><td>@Persian.Money(c.Allocated)</td><td>@Persian.Money(c.Reserved)</td><td>@Persian.Money(c.Paid)</td><td>@Persian.Money(c.Available)</td></tr> }</tbody>
        </table></div>
    </section>
    @if (Model.Proformas.Count > 0)
    {
        <section class="card"><h2>پیش‌پرداخت‌های منتظر اتصال به سند</h2>
            @foreach (var p in Model.Proformas)
            { <a asp-page="/Credit" asp-route-number="@p.Number">@p.Number · @p.Vendor · @Persian.Money(p.Amount) ریال</a> }
        </section>
    }
    @if (Model.History.Count > 0)
    {
        <section class="card"><h2>گردش اخیر اعتبار</h2>
            <div class="table-wrap"><table><thead><tr><th>مبدأ</th><th>مقصد</th><th>مبلغ</th><th>ثبت‌کننده</th></tr></thead>
            <tbody>@foreach (var h in Model.History)
            { <tr><td>@(h.Source ?? "تخصیص جدید")</td><td>@h.Destination</td><td>@Persian.Money(h.Amount)</td><td>@h.Actor</td></tr> }</tbody></table></div>
        </section>
    }
}
