@page
@model Amadban.Pages.CreditModel
@{
    ViewData["Title"] = Model.Invoice is not null || Model.Payment is not null ? "پیش‌پرداخت" : "اعتبار و پیش‌پرداخت";
}
<header class="hero"><div class="hero-main"><span class="hero-icon"><img src="/icon3d/money-bag.webp" width="82" height="82" alt=""></span><div><div class="eyebrow">اعتبار خرید</div><h1>@ViewData["Title"]</h1>
        <p>دو مسیر: <strong>پیش‌فاکتور</strong> (بدون سند) یا <strong>پیش‌پرداخت همان سند</strong> از پروندهٔ چکی بعد از صدور شماره سند.</p></div></div>
        @if (Model.Payment is { } pmt)
        {
            <a class="button primary" asp-page="/PrintPrepayment" asp-route-number="@pmt.Number">چاپ پیش‌پرداخت</a>
        }
        else if (Model.Proformas.Count > 0)
        {
            <a class="button" href="#open-prepayments">پیش‌پرداخت‌های منتظر اتصال</a>
        }
</header>
@if (Model.Message is not null) { <p class="notice" role="status">@Model.Message</p> }
@if (Model.Payment is { } payment)
{
    <section class="card">
        <h2>پیش‌پرداخت @payment.Number · @payment.Vendor</h2>
        <p>کد @payment.Code · @payment.CodeTitle · @Persian.Money(payment.Amount) ریال</p>
        <p>@(payment.State == "paid" ? "پرداخت‌شده" : payment.State == "void" ? "باطل‌شده" : "اعتبار رزرو شده")</p>
        <div class="actions">
            <a class="button" asp-page="/PrintPrepayment" asp-route-number="@payment.Number">چاپ پیش‌پرداخت A4</a>
            @if (payment.Invoice is long id) { <a class="button" asp-page="/Invoices/Detail" asp-route-id="@id">باز کردن سند</a> }
        </div>
        @if (payment.State != "void")
        {
            <form method="post" asp-page-handler="Action" class="filters">
                <input type="hidden" name="number" value="@payment.Number"><input type="hidden" name="invoice" value="@payment.Invoice">
                <label>کد صحیح<select name="code">@foreach (var c in Model.Codes) { <option value="@c.Id" @(c.Id == payment.CodeId ? "selected" : null)>@c.Code · @c.Title</option> }</select></label>
                <button class="button" name="action" value="code">اصلاح کد</button>
            </form>
            @if (Model.CanPrepay && payment.State == "reserved")
            {
                <form method="post" asp-page-handler="Action" class="actions">
                    <input type="hidden" name="number" value="@payment.Number"><input type="hidden" name="invoice" value="@payment.Invoice">
                    @if (payment.Invoice is not null) { <label class="inline"><input type="checkbox" name="proxy" value="true"> پرداخت گروهی در بانک</label> }
                    <button class="button primary" name="action" value="pay">ثبت پرداخت قطعی</button>
                    <button class="button" name="action" value="void">ابطال و آزادکردن اعتبار</button>
                </form>
            }
            @if (Model.CanPrepay && payment.Invoice is null)
            {
                <form method="post" asp-page-handler="Link" class="filters">
                    <input type="hidden" name="number" value="@payment.Number">
                    <label>شناسه پرونده خرید<input type="number" name="invoice" min="1" required></label>
                    <button class="button" type="submit">اتصال به پرونده</button>
                </form>
            }
        }
    </section>
}
<partial name="_CreditInvoiceSummary" />
@if (Model.InvoicePrepayNotice is not null)
{
    <p class="notice" role="status">@Model.InvoicePrepayNotice</p>
}
@if (Model.ShowProformaForm)
{
    <section class="card">
        <h2>انتخاب نوع پیش‌پرداخت</h2>
        <p><strong>پیش‌فاکتور:</strong> هنوز سند ندارید → فرم «پیش‌فاکتور» در همین صفحه (پایین).</p>
        <p><strong>سند صادرشده:</strong> پروندهٔ چکی در کارتابل → دکمهٔ سبز <strong>پیش‌پرداخت این سند</strong>، یا شناسهٔ پرونده:</p>
        <form method="get" class="filters">
            <label>شناسهٔ پرونده (از کارتابل روی سطر کلیک کنید؛ در آدرس مرورگر <code>Detail/123</code> عدد ۱۲۳ است)<input name="invoice" type="number" min="1" inputmode="numeric" required placeholder="مثلاً ۴۲"></label>
            <button class="button primary" type="submit">پیش‌پرداخت این سند</button>
        </form>
    </section>
}
@if (Model.ShowProformaForm || Model.ShowInvoiceForm)
{
    <section class="card" id="prepay-form">
        <h2>@(Model.Invoice is null ? "۱ — پیش‌پرداخت بر اساس پیش‌فاکتور" : $"پیش‌پرداخت سند {Model.Invoice!.Summary.Document} (همان فاکتور)")</h2>
        <p>اطلاعات را به ترتیب وارد کنید. اگر اعتبار کافی نباشد، مقدار کسری به شما نشان داده می‌شود و می‌توانید همین فرم را ادامه دهید.</p>
        <form method="post" asp-page-handler="Reserve" class="payment-form">
            <input type="hidden" name="submission" value="@Model.Submission">
            <input type="hidden" name="invoice" value="@(Model.Invoice?.Summary.Id ?? 0)">
            <div class="form-step"><div class="step-head"><span>۱</span><div><h2>خرید و اعتبار</h2><p>کد اعتباری و مبلغ این پیش‌پرداخت را مشخص کنید.</p></div></div>
                <div class="fields">
                    @if (Model.Invoice is null)
                    {
                        <label>شماره پیش‌فاکتور<input name="proforma" value="@Model.Pending?.Proforma" maxlength="80" required></label>
                        <label>فروشنده<input name="vendor" value="@Model.Pending?.Vendor" maxlength="180" required></label>
                    }
                    <label>کد اعتباری<select name="code" required><option value="">انتخاب کنید</option>@foreach (var c in Model.Codes) { <option value="@c.Id" @(Model.Pending?.Code == c.Id ? "selected" : null)>@c.Code · @c.Title · @Persian.Money(c.Available) ریال مانده</option> }</select></label>
                    <label>مبلغ (ریال)<input name="amount" dir="ltr" inputmode="numeric" value="@(Model.Pending?.Amount ?? Model.Invoice?.Summary.Total.ToString())" required></label>
                </div>
            </div>
            <div class="form-step"><div class="step-head"><span>۲</span><div><h2>حساب دریافت‌کننده</h2><p>اگر حساب فروشنده از قبل ثبت شده، آن را انتخاب کنید تا اطلاعات پر شود.</p></div></div>
                <div class="fields">
                    @if (Model.Accounts.Count > 0)
                    {
                        <label>حساب ثبت‌شده فروشنده<select data-account><option value="">انتخاب حساب</option>@foreach (var a in Model.Accounts) { <option value="@a.Id" data-owner="@a.Owner" data-bank="@a.Bank" data-sheba="@a.Sheba">@a.Bank · @a.Sheba</option> }</select></label>
                    }
                    <label>نام صاحب حساب<input name="owner" value="@Model.Pending?.Owner" maxlength="140" required></label>
                    <label>بانک<input name="bank" value="@Model.Pending?.Bank" maxlength="100" required></label>
                    <label>شماره شبا<input name="sheba" value="@Model.Pending?.Sheba" dir="ltr" maxlength="32" required></label>
                </div>
            </div>
            <div class="form-step"><div class="step-head"><span>۳</span><div><h2>اطلاعات تکمیلی (همه اختیاری)</h2><p>اگر مجوز یا مالیات جدا ندارید، این بخش را خالی بگذارید.</p></div></div>
                <div class="fields">
                    <label>شماره مجوز (اختیاری)<input name="permit" value="@Model.Pending?.Permit" maxlength="80" placeholder="در صورت نداشتن خالی بگذارید"></label>
                    <label>تاریخ مجوز (اختیاری)<input name="permitDate" value="@Model.Pending?.PermitDate" dir="ltr" maxlength="10" placeholder="۱۴۰۵/۰۱/۰۱"></label>
                    <label>مالیات جداگانه (اختیاری)<input name="tax" value="@Model.Pending?.Tax" inputmode="numeric"></label>
                </div>
            </div>
            <div class="actions between"><p>پس از ثبت، برگه چاپ می‌شود و مبلغ از مانده قابل استفاده این کد رزرو خواهد شد.</p><button class="button primary" type="submit">ثبت و رزرو اعتبار</button></div>
        </form>
        @if (Model.Pending is not null)
        {
            <p><a asp-page="/Credit" target="_blank" rel="noopener">افزایش یا انتقال اعتبار در پنجره جدا</a></p>
        }
        @if (Model.Invoice is not null)
        {
            <form method="post" asp-page-handler="Link" class="filters">
                <input type="hidden" name="invoice" value="@Model.Invoice.Summary.Id">
                <label>شماره پیش‌پرداخت قبلی<input name="number" type="number" min="1" required></label>
                <button class="button" type="submit">اتصال پیش‌پرداخت پیش‌فاکتور</button>
            </form>
        }
    </section>
}
@if (Model.Payment is null)
{
    @if (Model.Notices.Count > 0)
    {
        <section class="card"><h2>اعلان‌های اعتبار</h2><ul>@foreach (var item in Model.Notices) { <li>@item</li> }</ul></section>
    }
    <section class="card">
        <h2>کدهای اعتباری</h2>
        <form method="post" asp-page-handler="Add" class="filters">
            <label>شماره کد<input name="code" maxlength="40" required></label>
            <label>عنوان<input name="title" maxlength="150" required></label>
            <button class="button" type="submit">افزودن کد</button>
        </form>
        <form method="post" asp-page-handler="Allocate" class="filters">
            <label>مبدأ<select name="from"><option value="0">افزایش از تخصیص جدید</option>@foreach (var c in Model.Codes) { <option value="@c.Id">@c.Code · @c.Title</option> }</select></label>
            <label>مقصد<select name="to" required><option value="">انتخاب کنید</option>@foreach (var c in Model.Codes) { <option value="@c.Id">@c.Code · @c.Title</option> }</select></label>
            <label>مبلغ (ریال)<input name="amount" inputmode="numeric" required></label>
            <button class="button primary" type="submit">ثبت افزایش یا انتقال</button>
        </form>
        <div class="table-wrap"><table>
            <thead><tr><th>کد و عنوان</th><th>تخصیص</th><th>رزرو</th><th>مصرف قطعی</th><th>مانده قابل استفاده</th></tr></thead>
            <tbody>@foreach (var c in Model.Codes)
            { <tr><td>@c.Code · @c.Title</td><td>@Persian.Money(c.Allocated)</td><td>@Persian.Money(c.Reserved)</td><td>@Persian.Money(c.Paid)</td><td>@Persian.Money(c.Available)</td></tr> }</tbody>
        </table></div>
    </section>
    @if (Model.Proformas.Count > 0)
    {
        <section class="card" id="open-prepayments"><h2>پیش‌پرداخت‌های منتظر اتصال به سند</h2>
            <div class="table-wrap"><table><thead><tr><th>شماره</th><th>فروشنده</th><th>مبلغ</th><th>اقدام</th></tr></thead><tbody>
            @foreach (var p in Model.Proformas)
            {
                <tr><td>@p.Number</td><td>@p.Vendor</td><td class="numbers">@Persian.Money(p.Amount)</td>
                    <td class="actions"><a class="button" asp-page="/Credit" asp-route-number="@p.Number">مدیریت</a>
                        <a class="button" asp-page="/PrintPrepayment" asp-route-number="@p.Number">چاپ A4</a></td></tr>
            }</tbody></table></div>
        </section>
    }
    @if (Model.History.Count > 0)
    {
        <section class="card"><h2>گردش اخیر اعتبار</h2>
            <div class="table-wrap"><table><thead><tr><th>زمان و عملیات</th><th>مبدأ</th><th>مقصد</th><th>مبلغ</th><th>ثبت‌کننده</th></tr></thead>
            <tbody>@foreach (var h in Model.History)
            { <tr><td>@h.Operation<small>@Persian.Time(h.At)</small></td>
                <td>@(h.Source ?? "تخصیص جدید") @if (h.SourceBefore is long start) { <small>@Persian.Money(start) ← @Persian.Money(start - h.Amount)</small> }</td>
                <td>@h.Destination @if (h.DestinationBefore is long destinationStart) { <small>@Persian.Money(destinationStart) ← @Persian.Money(destinationStart + h.Amount)</small> }</td>
                <td>@Persian.Money(h.Amount)</td><td>@h.Actor</td></tr> }</tbody></table></div>
        </section>
    }
}
