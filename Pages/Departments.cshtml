@page
@model Amadban.Pages.DepartmentsModel
@{
    ViewData["Title"] = "بخش‌ها و مسئولین";
    var missingRecipients = Model.Roster.Where(r => r.Recipients.Count == 0).ToList();
}
<header class="hero"><div class="hero-main"><span class="hero-icon"><img src="/icon3d/folder.webp" width="82" height="82" alt=""></span><div>
    <div class="eyebrow">فهرست مشترک</div><h1>بخش‌ها و مسئولین بخش</h1>
    <p>نام بخش و نام مسئول را یک‌بار ثبت کنید؛ در فاکتور و انبار از لیست انتخاب می‌شوند.</p></div></div></header>
@if (Model.Message is not null) { <p class="notice" role="status">@Model.Message</p> }
@if (Model.Departments.Count == 0)
{
    <p class="notice" role="status"><strong>هنوز بخشی ثبت نشده است.</strong> قبل از ثبت نام روی سند یا ثبت حواله انبار، حداقل یک بخش و یک مسئول برای آن بخش تعریف کنید.</p>
}
else if (missingRecipients.Count > 0)
{
    <p class="notice" role="status">@missingRecipients.Count بخش هنوز شخص ثبت‌شده ندارند (@string.Join("، ", missingRecipients.Select(r => r.Name))).</p>
}
<section class="card">
    <h2>ثبت بخش و شخص</h2>
    <div class="detail-grid">
        <form method="post" asp-page-handler="Department" class="filters"><label>نام بخش<input name="name" maxlength="120" required placeholder="مثلاً اورژانس"></label><button class="button primary" type="submit">ثبت بخش</button></form>
        <form method="post" asp-page-handler="Person" class="filters"><label>بخش<select name="department" required><option value="">انتخاب کنید</option>@foreach (var d in Model.Departments) { <option value="@d.Id">@d.Name</option> }</select></label>
            <label>نام و نام خانوادگی<input name="name" maxlength="120" required></label><label>درجه<input name="rank" maxlength="80"></label><label>سمت<input name="position" maxlength="120" placeholder="مسئول بخش، رئیس قسمت، …"></label>
            <button class="button primary" type="submit">ثبت شخص برای این بخش</button></form>
    </div>
    <div class="table-wrap"><table><thead><tr><th>بخش</th><th>اشخاص (سند خرید و حواله انبار)</th></tr></thead><tbody>
    @foreach (var row in Model.Roster)
    {
        <tr><td>@row.Name</td><td>@if (row.Recipients.Count == 0) { <span class="badge returned">بدون شخص</span> }
            else { @string.Join(" · ", row.Recipients.Select(p => $"{p.Rank} {p.Name}".Trim() + (p.Position.Length > 0 ? " · " + p.Position : ""))) }</td></tr>
    }
    @if (Model.Roster.Count == 0) { <tr><td colspan="2" class="empty">بخشی ثبت نشده است.</td></tr> }
    </tbody></table></div>
    <details><summary>اصلاح نام، سمت یا بخش شخص</summary>
        @foreach (var row in Model.Roster)
        {
            foreach (var person in row.Recipients)
            {
                <form method="post" asp-page-handler="CorrectPerson" class="filters">
                    <input type="hidden" name="id" value="@person.Id">
                    <strong>@row.Name</strong>
                    <label>نام<input name="name" value="@person.Name" required maxlength="120"></label>
                    <label>درجه<input name="rank" value="@person.Rank" maxlength="80"></label>
                    <label>سمت<input name="position" value="@person.Position" maxlength="120"></label>
                    <label>بخش<select name="department">@foreach (var d in Model.Departments) { <option value="@d.Id" selected="@(person.DepartmentId == d.Id)">@d.Name</option> }</select></label>
                    <button class="button" type="submit">ذخیره</button>
                </form>
            }
        }
    </details>
</section>