@page
@model Amadban.Pages.DispatchModel
@{
    ViewData["Title"] = "ارسال کالا به بخش";
}
<header class="hero"><div class="hero-main"><span class="hero-icon"><img src="/icon3d/folder.webp" width="82" height="82" alt=""></span><div><div class="eyebrow">انبار بیمارستان</div><h1>ارسال کالا به بخش</h1><p>بخش و تحویل‌گیرنده را انتخاب کنید؛ کالا و تعداد را بنویسید؛ دکمهٔ سبز پایین صفحه.</p></div></div></header>
@if (Model.Message is not null) { <p class="notice" role="status">@Model.Message</p> }
@if (Model.WarehouseStaff.Count == 0)
{
    <p class="notice" role="status">هیچ کاربر با نقش <strong>انباردار</strong> فعال نیست. رئیس آماد از <a asp-page="/Staff">کاربران</a> یک حساب انباردار بسازد تا نام روی برگه خروج انتخاب شود.</p>
}
<section class="card">
    <partial name="_DepartmentSetupNotice" model="new DepartmentSetupNoticeModel(Model.Roster, Model.Departments.Count, true)" />
</section>
<section class="card">
    <div class="steps"><span>۱ · بخش و تحویل‌گیرنده</span><span>۲ · کالا و تعداد</span><span>۳ · چاپ و امضا</span></div>
    <form method="post" asp-page-handler="Issue" class="dispatch-form" id="dispatch-form">
        <input type="hidden" name="submission" value="@Model.Submission">
        <div class="fields">
            <label>بخش مقصد<select name="department" required @(Model.Departments.Count == 0 ? "disabled" : null)><option value="">بخش را انتخاب کنید</option>
                @foreach (var d in Model.Departments) { <option value="@d.Id">@d.Name</option> }
            </select></label>
            <label>شخص تحویل‌گیرنده<select name="recipient" required data-dispatch-recipient disabled><option value="">ابتدا بخش مقصد را انتخاب کنید</option></select></label>
            <label>نام انباردار روی برگه<select name="warehouse" required><option value="">انباردار را انتخاب کنید</option>
                @foreach (var member in Model.WarehouseStaff) { <option value="@member.Id">@member.Name</option> }
            </select></label>
            <label>تاریخ تحویل (شمسی)<input name="date" value="@Persian.Date(Persian.Today)" dir="ltr" required maxlength="10"></label>
            <label>یادداشت<input name="note" maxlength="250" placeholder="اختیاری"></label>
        </div>
        <h2>کالاهای تحویلی</h2>
        <p>نام یا کد کالا را تایپ کنید؛ موجودی در پیشنهادها نشان داده می‌شود.</p>
        <datalist id="dispatch-products"></datalist>
        <div class="table-wrap"><table class="entry-table"><thead><tr><th>کالا</th><th>تعداد</th><th></th></tr></thead>
            <tbody data-dispatch-lines><tr><td><input name="lines[0].code" data-dispatch-field="code" data-product-code list="dispatch-products" required aria-label="کد کالا" placeholder="نام یا کد"></td>
                <td><input name="lines[0].quantity" data-dispatch-field="quantity" required inputmode="decimal" aria-label="تعداد"></td>
                <td><button class="button button-remove" type="button" data-dispatch-remove>حذف</button></td></tr></tbody></table></div>
        <template data-dispatch-template><tr><td><input data-dispatch-field="code" data-product-code list="dispatch-products" required aria-label="کد کالا"></td>
            <td><input data-dispatch-field="quantity" required inputmode="decimal" aria-label="تعداد"></td>
            <td><button class="button button-remove" type="button" data-dispatch-remove>حذف</button></td></tr></template>
        <div class="actions between"><button class="button" type="button" data-dispatch-add>افزودن قلم</button>
            <button class="button primary" type="submit" @(Model.Departments.Count == 0 || Model.WarehouseStaff.Count == 0 ? "disabled" : null)>ثبت خروج و چاپ برگه</button></div>
    </form>
</section>
<section class="card"><h2>برگه‌های خروج اخیر</h2>
    <div class="table-wrap"><table><thead><tr><th>شماره</th><th>تاریخ</th><th>بخش</th><th>تحویل‌گیرنده</th><th></th></tr></thead><tbody>
    @foreach (var issue in Model.Recent) { <tr><td>@issue.Number</td><td>@Persian.Date(issue.Date)</td><td>@issue.Department</td><td>@issue.Recipient</td><td><a class="button" asp-page="/PrintDispatch" asp-route-number="@issue.Number">چاپ</a></td></tr> }
    @if (Model.Recent.Count == 0) { <tr><td colspan="5" class="empty">هنوز برگه‌ای ثبت نشده است.</td></tr> }
    </tbody></table></div>
</section>