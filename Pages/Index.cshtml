@page
@model Amadban.Pages.IndexModel
@{
    ViewData["Title"] = Model.Report ? "گزارش فاکتورها" : "کارتابل";
    var tabs = new[] {
        ("", "همه", "dashboard"), ("due", "سررسید پرداخت", "clock"), ("returned", "برگشتی", "return"),
        ("document", "در انتظار سند", "file"), ("kardex", "کارتکس ثبت‌نشده", "archive"), ("paid", "پرداخت‌شده", "check"),
        ("tax-pending", "در انتظار مالیات", "file"), ("ready", "آماده تحویل", "check"), ("delivered", "تحویل‌شده", "archive"), ("closed", "بسته‌شده", "check")
    };
}
<header class="hero">
    <div class="hero-main"><span class="hero-icon"><img src="/icon3d/@(Model.Report ? "chart" : "file-text").webp" width="82" height="82" alt=""></span>
        <div><div class="eyebrow">آماد و پشتیبانی</div><h1>@ViewData["Title"]</h1>
        <p>@(Model.Report ? "گزارش را با تاریخ، موضوع و وضعیت دلخواه ببینید." : "کارهای مهم امروز و مسیر هر پرونده را از اینجا دنبال کنید.")</p></div></div>
    @if (User.IsInRole("agent") || User.IsInRole("chief"))
    {
        <a class="button primary" asp-page="/Invoices/New"><svg aria-hidden="true"><use href="/icons.svg#plus"></use></svg> ثبت فاکتور</a>
    }
</header>
@if (Model.Setup is { } setup && (setup.Departments == 0 || setup.Suppliers == 0 || setup.DepartmentsWithoutRecipients > 0))
{
    <section class="card" aria-label="راه‌اندازی اولیه">
        <h2>تکمیل پایه‌دهی سامانه</h2>
        <p>برای اینکه انبار و اسناد خرید بدون گیر کار کنند، موارد زیر را یک‌بار تنظیم کنید.</p>
        <ul class="missing">
            @if (setup.Departments == 0) { <li><a asp-page="/Departments">بخش‌های بیمارستان</a> — هنوز بخشی ثبت نشده</li> }
            else if (setup.DepartmentsWithoutRecipients > 0) { <li><a asp-page="/Departments">بخش‌های بیمارستان</a> — @setup.DepartmentsWithoutRecipients بخش بدون تحویل‌گیرنده</li> }
            @if (setup.Suppliers == 0) { <li><a asp-page="/Suppliers">فروشندگان</a> — پرونده فروشنده ثبت نشده</li> }
            @if (User.IsInRole("chief") && setup.Departments > 0 && setup.Recipients == 0) { <li>حداقل یک تحویل‌گیرنده برای بخش‌ها لازم است</li> }
        </ul>
    </section>
}
@if (Model.Alerts is { } alerts)
{
    <section class="alert-grid" aria-label="کارهای نیازمند پیگیری">
        <a class="alert-tile" asp-page="/Index" asp-route-Status="kardex-late"><img src="/icon3d/clock.webp" width="48" height="48" alt=""><strong>@alerts.LateKardex</strong><span>کارتکس عقب‌افتاده</span></a>
        <a class="alert-tile" asp-page="/Index" asp-route-Status="kardex-current"><img src="/icon3d/notebook.webp" width="48" height="48" alt=""><strong>@alerts.CurrentKardex</strong><span>کارتکس این ماه</span></a>
        <a class="alert-tile" asp-page="/Index" asp-route-Status="due"><img src="/icon3d/money-bag.webp" width="48" height="48" alt=""><strong>@alerts.DuePayments</strong><span>پرداخت تا ۷ روز آینده</span></a>
        <a class="alert-tile" asp-page="/Index" asp-route-Status="returned"><img src="/icon3d/folder.webp" width="48" height="48" alt=""><strong>@alerts.Returned</strong><span>برگشتی از مالی یا معاونت</span></a>
        <a class="alert-tile" asp-page="/Index" asp-route-Status="document"><img src="/icon3d/file-text.webp" width="48" height="48" alt=""><strong>@alerts.Unnumbered</strong><span>در انتظار شماره سند</span></a>
    </section>
}
@if (User.IsInRole("chief") && Model.Activity.Count > 0)
{
    <section class="card activity-preview"><div class="actions between"><h2>تازه‌ترین کارهای آماد</h2><a class="button quiet" asp-page="/Activity">همه اطلاعیه‌ها</a></div>
        @foreach (var item in Model.Activity)
        { <a asp-page="/ActivityDetail" asp-route-id="@item.Id"><img src="/icon3d/@(item.Icon).webp" width="29" height="29" alt=""><strong>@item.Title</strong><span>@item.Summary</span><small>@item.Actor · @Persian.Time(item.At)</small></a> }
    </section>
}
<section class="card">
    <div class="tabs" aria-label="وضعیت پرونده">
        @foreach (var (code, label, icon) in tabs)
        {
            <a class="tab @(Model.Status == code ? "selected" : "")" asp-page="/Index" asp-route-Status="@code"
               asp-route-Report="@Model.Report" asp-route-Search="@Model.Search" asp-route-Subject="@Model.Subject" asp-route-Kind="@Model.Kind" asp-route-Credit="@Model.Credit" asp-route-From="@Model.From" asp-route-To="@Model.To">
                <svg aria-hidden="true"><use href="/icons.svg#@icon"></use></svg> @label
            </a>
        }
    </div>
    <form method="get" class="filters">
        <input type="hidden" name="Status" value="@Model.Status">
        <input type="hidden" name="Report" value="@Model.Report">
        <label>جست‌وجو <input name="Search" value="@Model.Search" maxlength="100" placeholder="فروشنده، موضوع یا شماره"></label>
        <label>از تاریخ <input name="From" value="@Model.From" dir="ltr" placeholder="۱۴۰۵/۰۱/۰۱" maxlength="10"></label>
        <label>تا تاریخ <input name="To" value="@Model.To" dir="ltr" placeholder="۱۴۰۵/۱۲/۲۹" maxlength="10"></label>
        @if (Model.Report)
        {
            <label>موضوع<input name="Subject" value="@Model.Subject" maxlength="100"></label>
            <label>نوع خرید<select name="Kind"><option value="">همه</option><option value="cash" selected="@(Model.Kind=="cash")">نقدی</option><option value="credit" selected="@(Model.Kind=="credit")">چکی</option></select></label>
            <label>کد اعتباری<input name="Credit" value="@Model.Credit" maxlength="40"></label>
        }
        <button type="submit" class="button"><svg aria-hidden="true"><use href="/icons.svg#search"></use></svg> نمایش</button>
    </form>
    <div asp-validation-summary="All" class="validation"></div>
    @if (Model.Report && ViewData.ModelState.IsValid)
    {
        <p class="notice">نتیجه کل بازه: @Model.Count پرونده · @Persian.Money(Model.Total) ریال</p>
        <p><a class="button" asp-page="/Analytics" asp-route-Status="@Model.Status" asp-route-Search="@Model.Search"
              asp-route-Subject="@Model.Subject" asp-route-Kind="@Model.Kind" asp-route-Credit="@Model.Credit"
              asp-route-From="@Model.From" asp-route-To="@Model.To">تحلیل گروهی خریدها</a></p>
        <p><a class="button" asp-page-handler="Export" asp-route-Status="@Model.Status" asp-route-Search="@Model.Search"
              asp-route-Subject="@Model.Subject" asp-route-Kind="@Model.Kind" asp-route-Credit="@Model.Credit"
              asp-route-From="@Model.From" asp-route-To="@Model.To">دریافت اکسل CSV از تمام ردیف‌های فیلترشده</a></p>
    }
    <div class="table-wrap">
        <table>
            <thead><tr><th>سند</th><th>فروشنده و موضوع</th><th>تاریخ فاکتور</th><th>مبلغ (ریال)</th><th>وضعیت</th><th>اقدام</th></tr></thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td>@(row.Document?.ToString() ?? "—")</td>
                        <td><strong>@row.Vendor</strong><small>@row.Subject · @(row.Kind == "cash" ? "نقدی" : "اعتباری")</small></td>
                        <td class="numbers">@Persian.Date(row.Date)</td>
                        <td class="numbers">@Persian.Money(row.Total)</td>
                        <td><span class="badge @row.Delivery">@(Model.Status == "ready" ? "آماده تحویل" : Amadban.Pages.IndexModel.Badge(row))</span></td>
                        <td><a asp-page="/Invoices/Detail" asp-route-id="@row.Id" class="button quiet">مشاهده</a></td>
                    </tr>
                }
                @if (Model.Rows.Count == 0) { <tr><td colspan="6" class="empty">پرونده‌ای برای نمایش نیست.</td></tr> }
            </tbody>
        </table>
    </div>
    @if (Model.P > 1 || Model.HasNext)
    {
        <nav class="pagination" aria-label="صفحه گزارش">
            @if (Model.P > 1) { <a class="button" asp-route-P="@(Model.P - 1)" asp-route-Status="@Model.Status" asp-route-Report="@Model.Report" asp-route-Search="@Model.Search" asp-route-Subject="@Model.Subject" asp-route-Kind="@Model.Kind" asp-route-Credit="@Model.Credit" asp-route-From="@Model.From" asp-route-To="@Model.To">قبلی</a> }
            @if (Model.HasNext) { <a class="button" asp-route-P="@(Model.P + 1)" asp-route-Status="@Model.Status" asp-route-Report="@Model.Report" asp-route-Search="@Model.Search" asp-route-Subject="@Model.Subject" asp-route-Kind="@Model.Kind" asp-route-Credit="@Model.Credit" asp-route-From="@Model.From" asp-route-To="@Model.To">بعدی</a> }
        </nav>
    }
</section>
