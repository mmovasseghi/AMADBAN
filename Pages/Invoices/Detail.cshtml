@page "{id:long}"
@model Amadban.Pages.Invoices.DetailModel
@{
    ViewData["Title"] = "پرونده خرید";
    var row = Model.Entry.Summary;
    var missing = Model.Missing;
}
<header class="hero">
    <div class="hero-main"><span class="hero-icon"><img src="/icon3d/file-text.webp" width="82" height="82" alt=""></span><div><div class="eyebrow">فاکتور @row.Number @(row.Document is long number ? $" · سند {number}" : "")</div><h1>@row.Subject</h1><p>@row.Vendor · @Persian.Date(row.Date)</p></div></div>
    <div class="actions hero-actions">
        <a class="button" asp-page="/Index">بازگشت به صفحهٔ اصلی</a>
        @if (row.Document is not null) { <a class="button primary" asp-page="Print" asp-route-id="@row.Id">چاپ سند</a> }
        @if (row.Kind == "credit" && Model.HandlesFinance)
        {
            if (row.Document is not null && !row.Paid)
            {
                <a class="button primary" asp-page="/Credit" asp-route-invoice="@row.Id">پیش‌پرداخت این سند</a>
            }
            else if (row.Document is null)
            {
                <a class="button" asp-page="/Credit">پیش‌پرداخت (پیش‌فاکتور)</a>
            }
        }
        @if (row.Document is not null && Model.Entry.Meeting)
        {
            <a class="button" asp-page="/PrintForms" asp-route-kind="meeting" asp-route-id="@row.Id">چاپ صورت‌جلسه</a>
        }
        @if (Model.HandlesFinance && Model.Editable)
        {
            <a class="button" asp-page="New" asp-route-id="@row.Id">اصلاح فاکتور</a>
        }
    </div>
</header>
<partial name="_EasyNextStep" model="missing" />
@if (Model.Message is not null) { <p class="notice" role="status">@Model.Message</p> }
<section class="card">
    <div class="stage"><span>فاکتور ثبت شد</span><span>@(row.Document is null ? "منتظر صدور سند" : "سند صادر شد")</span><span>@(row.Paid ? "پرداخت شد" : "منتظر پرداخت")</span><strong>@(missing.Count == 0 && row.Delivery == "open" ? "آماده تحویل" : Amadban.Pages.IndexModel.Badge(row))</strong></div>
    <div class="table-wrap"><table>
        <thead><tr><th>قلم</th><th>واحد</th><th>تعداد</th><th>قیمت واحد</th><th>مبلغ (ریال)</th></tr></thead>
        <tbody>@foreach (var line in Model.Entry.Lines)
        { <tr><td>@line.Title</td><td>@line.Unit</td><td class="numbers">@line.Quantity.ToString("0.###")</td><td class="numbers">@Persian.Money(line.Price)</td><td class="numbers">@Persian.Money(line.Amount)</td></tr> }</tbody>
        <tfoot><tr><th colspan="4">جمع کل</th><td class="numbers">@Persian.Money(row.Total)</td></tr></tfoot>
    </table></div>
    @if (Model.CanIssue)
    {
        <form method="post" asp-page-handler="Issue" class="actions"><button class="button primary" type="submit">صدور شماره سند</button></form>
    }
</section>
@if (Model.HandlesFinance && Model.Editable)
{
    <section class="card"><h2>بخش درخواست‌کننده و کارشناس امضاکننده</h2>
        <p>بخش و شخص را از همان فهرست مشترک <a asp-page="/Departments">بخش‌ها و مسئولین</a> انتخاب می‌کنید. نام کارشناس روی چاپ سند می‌آید. تحویل فیزیکی کالا از انبار در صفحه <a asp-page="/Dispatch">حواله به بخش</a> جداگانه ثبت می‌شود.</p>
        @if (Model.Departments.Count == 0)
        {
            <p class="notice" role="status">فهرست بخش‌ها خالی است. ابتدا در <a asp-page="/Departments">بخش‌ها و مسئولین</a> بخش و مسئول بخش را ثبت کنید، سپس اینجا انتخاب کنید.</p>
        }
        <form method="post" asp-page-handler="RequestSigner" class="filters" id="request-signer-form" data-invoice-id="@row.Id"
              data-selected-department="@Model.RequestSigner.DepartmentId" data-selected-expert="@Model.RequestSigner.ExpertId">
            <label>بخش درخواست‌کننده<select name="department" data-request-department><option value="0">انتخاب نشده</option>
                @foreach (var department in Model.Departments) { <option value="@department.Id" @(Model.RequestSigner.DepartmentId==department.Id ? "selected" : null)>@department.Name</option> }
            </select></label>
            <label>کارشناس / رئیس قسمت<select name="expert" data-request-expert required><option value="0">ابتدا بخش را انتخاب کنید</option></select></label><button type="submit" class="button">ثبت نام روی سند</button>
        </form>
        @if (Model.Entry.Meeting) { <form method="post" asp-page-handler="MeetingExtra" class="filters">
            <label>امضاکننده اضافه صورت‌جلسه<select name="person"><option value="0">بدون نفر اضافه</option>
                @foreach (var person in Model.People) { <option value="@person.Id" @(Model.MeetingExtra.Id==person.Id ? "selected" : null)>@person.Rank @person.Name · @person.Position</option> }
            </select></label><button class="button" type="submit">ثبت روی صورت‌جلسه</button>
        </form> }
    </section>
}
@if (row.Document is not null)
{
    var printItems = new[] {
        (Kind: "meeting", Label: "صورت‌جلسه", Required: Model.Entry.Meeting),
        (Kind: "invoice", Label: "فاکتور", Required: true),
        (Kind: "account", Label: "تأییدیه حساب", Required: Model.Entry.Account),
        (Kind: "taxpayer", Label: "برگه مؤدیان", Required: row.Kind == "credit" && Model.Entry.Tax),
        (Kind: "tax", Label: "برگه ثبت مالیات", Required: true)
    };
    <section class="card">
        <h2><svg aria-hidden="true"><use href="/icons.svg#print"></use></svg> ترتیب چاپ مدارک سند</h2>
        <ol class="print-order">
            <li><a asp-page="Print" asp-route-id="@row.Id" target="_blank" rel="noopener">روکش سند</a></li>
            @foreach (var item in printItems.Where(item => item.Required))
            {
                var attachment = Model.Entry.Attachments.FirstOrDefault(file => file.Kind == item.Kind);
                <li>
                    @if (attachment is not null)
                    {
                        <a asp-page-handler="Attachment" asp-route-attachment="@attachment.Id" asp-route-preview="true" target="_blank" rel="noopener">@item.Label</a>
                    }
                    else if (item.Kind == "meeting")
                    {
                        <a asp-page="/PrintForms" asp-route-kind="meeting" asp-route-id="@row.Id" target="_blank" rel="noopener">چاپ صورت‌جلسه</a>
                    }
                    else if (item.Kind == "tax" && Model.Entry.TaxBatchId is long batch)
                    {
                        <a asp-page="/TaxBatch" asp-page-handler="File" asp-route-id="@batch" asp-route-invoice="@row.Id" target="_blank" rel="noopener">برگه مالیات گروهی @batch</a>
                    }
                    else
                    {
                        <span>@item.Label</span> <span class="badge returned">پیوست نشده</span>
                    }
                </li>
            }
        </ol>
    </section>
}
@if (Model.Entry.Account && Model.SupplierAccounts.Count>0)
{ <section class="card"><h2>چاپ تأییدیه حساب</h2><p>حساب درست را انتخاب کنید، برگه را چاپ و پس از امضا اسکن آن را در همین پرونده بارگذاری کنید.</p>
    <div class="actions">@foreach (var account in Model.SupplierAccounts)
    { <a class="button" asp-page="/PrintAccountConfirmation" asp-route-invoice="@row.Id" asp-route-account="@account.Id" target="_blank" rel="noopener">@account.Bank · @account.Sheba</a> }</div>
</section> }
<div class="detail-grid">
@if (row.Warehouse)
{
    <section class="card">
        <h2><svg aria-hidden="true"><use href="/icons.svg#box"></use></svg> ورود اقلام به انبار</h2>
        @if (Model.Entry.WarehouseReceiptDate is DateOnly receiptDate)
        {
            <p>همه اقلام این فاکتور در تاریخ @Persian.Date(receiptDate) به موجودی افزوده شده‌اند.</p>
        }
        else if (Model.Entry.HasManualStock)
        {
            <p>برای این سند گردش دستی انبار ثبت شده است. جزئیات از صفحه موجودی هر کالا قابل مشاهده است.</p>
        }
        else
        {
            <p>ورود اقلام این سند هنوز ثبت نشده است.</p>
        }
        @if (Model.CanReceive && Model.Editable && row.Document is not null && !Model.Entry.HasManualStock)
        {
            <form method="post" asp-page-handler="Receipt" class="filters">
                <label>تاریخ شمسی گردش<input name="date" dir="ltr" required value="@Persian.Date(Persian.Today)"></label>
                @if (Model.Entry.WarehouseReceiptDate is null)
                {
                    <p class="receipt-help-long">نام هر قلم روی فاکتور و چاپ عوض نمی‌شود؛ فقط <strong>موجودی انبار</strong> به کالای انتخاب‌شده اضافه می‌شود. اگر نام فاکتور با نام کالای انبار <strong>شروع شود</strong> (مثلاً فاکتور «سیب درجه یک» و کالای «سیب»)، کد همان کالا از قبل پر می‌شود — قبل از ثبت بررسی کنید. <strong>بدون کد و بدون تیک «کالای جدید»</strong> ورود ثبت نمی‌شود تا اشتباهاً سیبِ جدا ساخته نشود. فقط وقتی واقعاً قلم تازه در انبار ندارید، تیک «کالای جدید» را بزنید.</p>
                    <p class="receipt-help-short">اگر جلوی هر ردیف <strong>کد پر شده</strong>، همان را نگه دارید و دکمهٔ سبز پایین را بزنید. اگر خالی بود و کالای جدید می‌خواهید، تیک «ساخت قلم جدید» را بزنید.</p>
                    <datalist id="receipt-products"></datalist>
                    <div class="table-wrap"><table><thead><tr><th>نام عین فاکتور</th><th>تعداد و واحد</th><th>کد کالا در انبار</th><th>کالای جدید</th></tr></thead><tbody>
                    @foreach (var item in Model.ReceiptMatches) { <tr><td>@item.Title</td><td>@item.Quantity.ToString("0.###") @item.Unit</td>
                        <td><input name="productCodes[@(item.Position-1)]" value="@item.Code" list="receipt-products" data-receipt-product
                                   data-invoice-title="@item.Title" placeholder="کد کالا" required aria-label="کد انبار برای @item.Title">
                            <small>@(item.Product is null ? "کد را انتخاب کنید یا تیک کالای جدید" : item.PrefixSuggested ? "پیشنهاد: " + item.Product : item.Product)</small></td>
                        <td><label class="inline"><input type="hidden" name="createNew[@(item.Position-1)]" value="false">
                            <input name="createNew[@(item.Position-1)]" value="true" type="checkbox" @(item.Code is null ? "" : "disabled")><span>ساخت قلم جدید</span></label></td></tr> }
                    </tbody></table></div>
                    <button class="button primary" name="operation" value="receive" type="submit">ثبت ورود همه اقلام فاکتور</button>
                }
                else
                {
                    <button class="button" name="operation" value="void" type="submit">برگرداندن ورود برای اصلاح</button>
                }
            </form>
        }
        <p>با تیک «کالای جدید»، شناسه انبار خودکار ساخته می‌شود و نام قلم همان متن فاکتور می‌ماند.</p>
    </section>
}
<section class="card">
    <h2><svg aria-hidden="true"><use href="/icons.svg#archive"></use></svg> کارتکس و تحویل</h2>
    @if (row.Warehouse)
    {
        <p>مهلت کارتکس: <bdi>@Persian.Date(Persian.MonthEnd(row.Date))</bdi></p>
        @if (row.Kardex is not null) { <p>شماره کارتکس @row.Kardex @if (Model.Entry.KardexDate is DateOnly k && k > Persian.MonthEnd(row.Date)) { <span class="badge returned">ثبت با تأخیر</span> }</p> }
        else if (Persian.Today > Persian.MonthEnd(row.Date)) { <p class="badge returned">کارتکس از موعد گذشته است</p> }
        @if (Model.CanKardex && Model.Editable)
        {
            <form method="post" asp-page-handler="Kardex" class="filters">
                <label>شماره کارتکس<input name="number" required maxlength="80" value="@row.Kardex"></label>
                <label>تاریخ ثبت<input name="date" required dir="ltr" value="@Persian.Date(Model.Entry.KardexDate ?? Persian.Today)"></label>
                <button class="button primary" type="submit">ثبت کارتکس</button>
            </form>
        }
    }
    @if (missing.Count > 0) { <p>مانده تا آماده تحویل</p><ul class="missing">@foreach (var item in missing) { <li>@item</li> }</ul> }
    @if (Model.HandlesFinance && row.Document is not null)
    {
        <form method="post" asp-page-handler="Finance" class="actions">
            @if (!row.Paid && Model.Editable && row.Kind == "cash" && User.IsInRole("agent")) { <button class="button" name="action" value="pay">ثبت پرداخت</button> }
            @if (row.Delivery is "open" or "returned" && missing.Count == 0) { <button class="button primary" name="action" value="deliver">ثبت تحویل به مالی</button> }
            @if (row.Paid && row.Kind == "credit" && Model.Editable)
            {
                @if (Model.Entry.Proxy) { <button class="button" name="action" value="clear-proxy">رفع نیاز به نیابتی</button> }
                else { <button class="button" name="action" value="require-proxy">پرداخت گروهی در بانک</button> }
            }
            @if (row.Delivery == "delivered" && row.ReviewStage == "finance")
            {
                <button class="button" name="action" value="return-finance">برگشت از مالی</button>
                <button class="button primary" name="action" value="send-deputy">ارسال به معاونت</button>
            }
            @if (row.Delivery == "delivered" && row.ReviewStage == "deputy")
            {
                <button class="button" name="action" value="return-deputy">برگشت از معاونت</button>
                <button class="button primary" name="action" value="close">تأیید نهایی و بستن سند</button>
            }
        </form>
    }
</section>
<section class="card">
    <h2><svg aria-hidden="true"><use href="/icons.svg#file"></use></svg> مدارک پرونده</h2>
    @if (row.Kind == "cash" && Model.HandlesFinance && Model.Editable)
    {
        <form method="post" asp-page-handler="Pos" class="actions">
            <span>پرفراژ کارت‌خوان در همان اسکن فاکتور دیده می‌شود؟</span>
            <button class="button" name="embedded" value="@(!Model.Entry.PosInInvoice ? "true" : "false")" type="submit">@(Model.Entry.PosInInvoice ? "بله، ثبت شده · تغییر به مدرک جدا" : "بله، داخل اسکن است")</button>
        </form>
    }
    @if (Model.Entry.Attachments.Count == 0) { <p>هنوز مدرکی پیوست نشده است.</p> }
    @foreach (var file in Model.Entry.Attachments)
    {
        <p><a asp-page-handler="Attachment" asp-route-attachment="@file.Id">@Amadban.Pages.Invoices.DetailModel.AttachmentKinds[file.Kind] · @file.Name</a></p>
    }
    @if(Model.Entry.TaxBatchId is long batchId)
    { <p><a asp-page="/TaxBatch" asp-page-handler="File" asp-route-id="@batchId" asp-route-invoice="@row.Id" target="_blank" rel="noopener">برگه مالیات گروهی @batchId</a></p>
        @if(Model.HandlesFinance && Model.Editable)
        { <form method="post" asp-page-handler="TaxUnlink"><button class="button" type="submit" data-confirm="پیوند این سند با برگه مالیات گروهی برداشته شود؟">اصلاح پیوند برگه مالیات</button></form> }
    }
    @if (Model.HandlesFinance && Model.Editable && row.Kind == "credit")
    {
        <form method="post" asp-page-handler="SupplierDocument" class="actions">
            @if (Model.Entry.Account) { <button class="button" name="kind" value="account">افزودن تأییدیه از پرونده فروشنده</button> }
            @if (Model.Entry.Tax) { <button class="button" name="kind" value="taxpayer">افزودن مؤدیان از پرونده فروشنده</button> }
        </form>
    }
    @if (Model.CanAttach && Model.Editable)
    {
        <form method="post" enctype="multipart/form-data" asp-page-handler="Attach" class="filters">
            <label>نوع مدرک<select name="kind">@foreach (var (kind, label) in Amadban.Pages.Invoices.DetailModel.AttachmentKinds) { <option value="@kind">@label</option> }</select></label>
            <label>فایل<input type="file" name="file" required accept=".pdf,.jpg,.jpeg,.png"></label>
            <button class="button" type="submit">پیوست مدرک</button>
        </form>
    }
</section>
</div>

<section class="card"><h2>سابقه پرونده</h2>
    <div class="table-wrap"><table><thead><tr><th>زمان</th><th>اقدام</th><th>ثبت‌کننده</th></tr></thead>
    <tbody>@foreach (var entry in Model.Entry.Events)
    { <tr><td>@Persian.Time(entry.At)</td><td>@entry.Action</td><td>@entry.Actor</td></tr> }</tbody></table></div>
</section>
