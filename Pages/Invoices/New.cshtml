@page
@model Amadban.Pages.Invoices.NewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "ثبت فاکتور" : "اصلاح فاکتور";
}
<header class="hero"><div class="hero-main"><span class="hero-icon"><img src="/icon3d/file-text.webp" width="82" height="82" alt=""></span>
    <div><div class="eyebrow">خرید و فاکتورها</div><h1>@ViewData["Title"]</h1><p>اطلاعات را به ترتیب پایین وارد کنید. تا زمان تحویل به مالی، اصلاح فاکتور ممکن است.</p></div></div><a asp-page="/Index" class="button">بازگشت به کارتابل</a></header>
<form method="post" class="card invoice-form">
    <input type="hidden" asp-for="Submission">
    <input type="hidden" asp-for="Id">
    <div asp-validation-summary="All" class="validation"></div>
    <section class="form-step"><div class="step-head"><span>۱</span><div><h2>مشخصات فاکتور</h2><p>شماره، تاریخ و نام فروشنده را از روی فاکتور وارد کنید.</p></div></div>
    <div class="fields">
        <label>شماره فاکتور<input asp-for="Number" required autofocus maxlength="80" placeholder="شماره درج‌شده روی فاکتور"></label>
        <label>تاریخ فاکتور (شمسی)<input asp-for="Date" required dir="ltr" maxlength="10" placeholder="۱۴۰۵/۰۸/۲۹"></label>
        <label>نام فروشنده<input asp-for="Vendor" required maxlength="180" list="supplier-names" data-supplier autocomplete="off"><datalist id="supplier-names"></datalist></label>
        <label>موضوع خرید<input asp-for="Subject" required maxlength="250" placeholder="مثلاً خرید ملزومات بخش جراحی"></label>
        <label>نوع پرداخت<select asp-for="Kind"><option value="credit">اعتباری / چکی</option><option value="cash">نقدی</option></select></label>
        <label data-cash-code>کد موضوعی خرید نقدی<select asp-for="CashCredit"><option value="0">انتخاب نشده</option>
            @foreach (var c in Model.Codes) { <option value="@c.Id">@c.Code · @c.Title</option> }
        </select></label>
    </div></section>
    <section class="form-step"><div class="step-head"><span>۲</span><div><h2>مدارک و مسیر کالا</h2><p>فقط گزینه‌هایی را فعال کنید که برای این فاکتور لازم‌اند. وضعیتشان بعداً در پرونده نشان داده می‌شود.</p></div></div>
    <div class="checks">
        <label><input asp-for="Warehouse"><span><strong>ورود به انبار</strong><small>کالا در موجودی ثبت می‌شود</small></span></label>
        <label><input asp-for="Meeting"><span><strong>صورت‌جلسه لازم است</strong><small>برای خدمت یا شرایط خاص</small></span></label>
        <label><input asp-for="Account"><span><strong>تأییدیه حساب لازم است</strong><small>مدرک حساب فروشنده</small></span></label>
        <label><input asp-for="Tax"><span><strong>برگه مؤدیان لازم است</strong><small>مالیات یا ارزش افزوده فاکتور</small></span></label>
    </div>
    <p class="form-note">برگه ثبت مالیات برای همه پرونده‌ها پیش از تحویل به مالی پیوست می‌شود.</p></section>
    <section class="form-step"><div class="step-head"><span>۳</span><div><h2>اقلام فاکتور</h2><p>هر ردیف روی فاکتور را جداگانه وارد کنید. حداکثر ۲۰ قلم پذیرفته می‌شود و مبلغ کل خودکار محاسبه می‌شود.</p></div></div>
    <div class="table-wrap">
        <table class="entry-table">
            <thead><tr><th>نام کالا یا خدمت</th><th>واحد</th><th>تعداد</th><th>قیمت واحد (ریال)</th><th>حذف</th></tr></thead>
            <tbody data-lines>
            @for (var i = 0; i < Model.Lines.Count; i++)
            {
                <tr>
                    <td><input asp-for="Lines[i].Title" data-field="Title" aria-label="نام کالا یا خدمت" maxlength="250"></td>
                    <td><input asp-for="Lines[i].Unit" data-field="Unit" aria-label="واحد" placeholder="عدد" maxlength="30"></td>
                    <td><input asp-for="Lines[i].Quantity" data-field="Quantity" aria-label="تعداد" inputmode="decimal" maxlength="14"></td>
                    <td><input asp-for="Lines[i].Price" data-field="Price" aria-label="قیمت واحد" inputmode="numeric" maxlength="20"></td>
                    <td><button class="button quiet" type="button" data-remove aria-label="حذف قلم">×</button></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <template data-line-template>
        <tr>
            <td><input data-field="Title" aria-label="نام کالا یا خدمت" maxlength="250"></td>
            <td><input data-field="Unit" aria-label="واحد" placeholder="عدد" maxlength="30"></td>
            <td><input data-field="Quantity" aria-label="تعداد" inputmode="decimal" maxlength="14" value="1"></td>
            <td><input data-field="Price" aria-label="قیمت واحد" inputmode="numeric" maxlength="20"></td>
            <td><button class="button quiet" type="button" data-remove aria-label="حذف قلم">×</button></td>
        </tr>
    </template>
    <div class="actions between">
        <button type="button" class="button" data-add-line><svg aria-hidden="true"><use href="/icons.svg#plus"></use></svg> افزودن قلم</button>
        <small data-line-limit>حداکثر ۲۰ قلم</small>
        <div>جمع تقریبی <output data-total>۰</output> ریال</div>
        <button type="submit" class="button primary"><svg aria-hidden="true"><use href="/icons.svg#check"></use></svg> ذخیره فاکتور</button>
    </div></section>
</form>
