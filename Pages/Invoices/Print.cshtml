@page "{id:long}"
@model Amadban.Pages.Invoices.PrintModel
@inject Store Store
@{
    Layout = null;
    var row = Model.Entry.Summary;
    var signers = await Store.SignersAsync();
    var request = await Store.RequestSignerAsync(row.Id);
    var payment = row.Kind == "credit" ? await Store.ReadPrepaymentAsync(row.Id, true) : null;
    var requestDate = row.Date.AddDays(-1);
}
<!doctype html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>سند @row.Document · آمادبان</title>
    <link rel="stylesheet" href="~/print.css" asp-append-version="true">
    <script src="~/site.js" asp-append-version="true" defer></script>
</head>
<body>
        <nav class="print-controls">
        <label>تعداد نسخه <input type="number" data-print-copies min="1" max="12" value="1"></label>
        <button type="button" data-print>چاپ سند A4</button><a asp-page="Detail" asp-route-id="@row.Id">بازگشت به پرونده</a>
        <form method="get"><label>قالب <select name="template">@foreach (var (key, title) in Amadban.Pages.PrintSettingsModel.Documents)
        { <option value="@key" selected="@(key==Model.Template)">@title</option> }</select></label><button type="submit">انتخاب</button></form>
        <form method="post" asp-page="/PrintSettings"><input type="hidden" name="form" value="document"><input type="hidden" name="id" value="@row.Id">
            <input type="hidden" name="template" value="@Model.Template"><button type="submit">تنظیم به‌عنوان پیش‌فرض</button></form>
    </nav>
    <div class="document-print-page"><article class="document-sheet">
        <header>
            @await Html.PartialAsync("_BrandMarks", true)
            <p>بسمه‌تعالی</p>
            <h1>درخواست خرید، گزارش دریافت، سند هزینه فرعی خرید کالا و خدمات</h1>
            <p>بیمارستان امام سجاد (ع) فراجا ـ دایره آماد و پشتیبانی</p>
        </header>
        <p class="document-letter">از: آماد &nbsp; به: ریاست محترم بیمارستان. با احترام، این یگان به کالا و خدمات زیر نیاز دارد؛ خواهشمند است دستور فرمایید نسبت به تهیه و تدارک آنها اقدام لازم معمول شود.</p>
        <section class="metadata">
            <span>شماره سند <b>@row.Document</b></span><span>شماره فاکتور <b>@row.Number</b></span>
            <span>تاریخ درخواست <bdi>@Persian.Date(requestDate)</bdi></span><span>تاریخ فاکتور <bdi>@Persian.Date(row.Date)</bdi></span>
            <span>فروشنده <b>@row.Vendor</b></span><span>بخش درخواست‌کننده <b>@(request.Department ?? "—")</b></span>
            <span>شماره پیش‌پرداخت <b>@(payment is null || row.Kind == "cash" ? "" : $"پ {payment.Number}")</b></span>
        </section>
        <table>
            <thead><tr><th>ردیف</th><th>مشخصات کالا یا خدمت</th><th>واحد</th><th>تعداد</th><th>قیمت واحد (ریال)</th><th>مبلغ کل (ریال)</th></tr></thead>
            <tbody>
                @for (var i = 0; i < Model.Entry.Lines.Count; i++)
                {
                    var line = Model.Entry.Lines[i];
                    <tr><td>@(i + 1)</td><td>@line.Title</td><td>@line.Unit</td><td>@line.Quantity.ToString("0.###")</td><td>@Persian.Money(line.Price)</td><td>@Persian.Money(line.Amount)</td></tr>
                }
                @for (var i = Model.Entry.Lines.Count; i < Model.Rows; i++)
                { <tr><td>@(i + 1)</td><td>&nbsp;</td><td></td><td></td><td></td><td></td></tr> }
            </tbody>
        </table>
        <section class="metadata totals"><span>جمع کل به عدد <b>@Persian.Money(row.Total) ریال</b></span><span>جمع کل به حروف <b>@PersianWords.Number(row.Total) ریال</b></span><span>شماره کارتکس <b>@(row.Kardex ?? "................")</b></span></section>
        <section class="signatures"><div>مسئول قسمت درخواست‌کننده<p>@signers.GetValueOrDefault("requester")</p></div>
            <div>مسئول مالی / عامل ذی‌حساب<p>@signers.GetValueOrDefault("finance")</p></div>
            <div>فرمانده / رئیس (دارنده مجوز ماده ۵۳)<p>@signers.GetValueOrDefault("chief")</p></div></section>
        <section class="signatures"><div>اقدام‌کننده / تنظیم‌کننده<p>اقلام تصویبی با کنترل کیفیت و قیمت خریداری شد.</p><p>@signers.GetValueOrDefault("agent")</p></div>
            <div>کارشناس / رئیس قسمت<p>اقلام یا خدمات بررسی و با مندرجات سند تطبیق داده شد.</p><p>@(request.Expert ?? signers.GetValueOrDefault("expert"))</p></div>
            <div>انباردار<p>اقلام انباری بررسی و دریافت شد.</p><p>@signers.GetValueOrDefault("warehouse")</p></div></section>
        <section class="metadata"><span>گواهی گزارش دریافت: @(row.Warehouse ? "اقلام به انبار تحویل شد." : "خدمت یا کالای غیرانباری بررسی شد.")</span>
            <span>تاریخ دریافت @(row.Warehouse ? Persian.Date(row.Date) : "")</span><span>تاریخ دریافت انبار @(row.Warehouse ? Persian.Date(row.Date) : "")</span></section>
        <section class="signatures"><div>کارتکس<p>@signers.GetValueOrDefault("kardex")</p></div>
            <div>فرمانده / رئیس (دارنده مجوز ماده ۵۳)<p>پرداخت با اطلاع و دستور اینجانب است.</p><p>@signers.GetValueOrDefault("chief")</p></div>
            <div>ممیز اسناد هزینه<p>صحت ارقام و تشریفات صوری سند بررسی شد.</p><p>@signers.GetValueOrDefault("auditor")</p></div>
            <div>عامل ذی‌حساب<p>@signers.GetValueOrDefault("finance")</p></div></section>
    </article></div>
</body>
</html>
