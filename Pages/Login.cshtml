@page
@model Amadban.Pages.LoginModel
@{
    ViewData["Title"] = "ورود";
}
<div class="login-shell">
    <section class="login-intro" aria-label="معرفی سامانه">
        <div class="login-org"><div class="login-logos"><img src="/BrandAsset/faraja" width="63" height="86" alt="نشان فراجا"><img src="/BrandAsset/health" width="76" height="86" alt="نشان معاونت بهداشت، امداد و درمان فراجا"></div>
            <span>بیمارستان فوق تخصصی امام سجاد (ع) فراجا<small>دایره آماد و پشتیبانی</small></span></div>
        <div class="login-illustration"><span class="login-emblem"><img src="/amadban-mark.svg" width="140" height="140" alt="نشان آمادبان"></span></div>
        <div><p class="eyebrow">سامانه داخلی بیمارستان</p><h1>آمادبان</h1><p>خرید، انبار، کارتکس و اسناد در یک مسیر روشن و قابل پیگیری</p></div>
        <div class="login-points"><span>ثبت آسان فاکتور</span><span>پیگیری هر سند</span><span>گزارش‌های کاربردی</span></div>
    </section>
    <section class="login card">
        <div class="login-welcome"><img src="/icon3d/key.webp" width="64" height="64" alt=""><div><p class="eyebrow">خوش آمدید</p><h2>ورود به حساب کاربری</h2></div></div>
        <p class="login-help">۱) نام کاربری را بنویسید &nbsp; ۲) رمز را بنویسید &nbsp; ۳) دکمهٔ سبز <strong>ورود</strong> را یک‌بار بزنید.</p>
        @if (!string.IsNullOrEmpty(Model.Banner))
        {
            <p class="validation" role="alert">@Model.Banner</p>
        }
        <form method="post" asp-page="/Login">
            <div asp-validation-summary="All" class="validation"></div>
            <label>نام کاربری<input asp-for="Username" autocomplete="username" maxlength="100" required autofocus placeholder="نام کاربری شما"></label>
            <label>رمز ورود<input asp-for="Password" type="password" autocomplete="current-password" maxlength="256" required placeholder="رمز ورود شما"></label>
            <button class="button primary login-submit" type="submit">ورود به آمادبان <svg aria-hidden="true"><use href="/icons.svg#check"></use></svg></button>
        </form>
        <p class="login-foot">اگر نام کاربری یا رمز را ندارید، از رئیس آماد دریافت کنید.</p>
    </section>
</div>
