@page
@model Amadban.Pages.OrganizationModel
@{
    ViewData["Title"] = "نشان و نام‌های چاپی";
}
<header class="hero"><div class="hero-main"><span class="hero-icon"><img src="/icon3d/setting.webp" width="82" height="82" alt=""></span><div><div class="eyebrow">برگه‌های رسمی</div><h1>نشان‌ها و نام امضاکنندگان</h1><p>شخص را یک‌بار تعریف کنید تا نام و سمت او در جای درست برگه‌های چاپی بیاید.</p></div></div></header>
@if (Model.Message is not null) { <p class="notice" role="status">@Model.Message</p> }
<section class="card">
    <h2>فایل اصلی نشان</h2>
    <form method="post" asp-page-handler="Logo" enctype="multipart/form-data" class="filters">
        <label>جایگاه نشان<select name="code"><option value="faraja">فراجا</option><option value="health">معاونت بهداشت، امداد و درمان</option></select></label>
        <label>فایل اصلی<input type="file" name="file" accept=".png,.jpg,.jpeg" required></label>
        <button type="submit" class="button primary">ذخیره نشان</button>
    </form>
</section>
<section class="card">
    <h2>تعریف شخص برای امضا</h2>
    <p>نام و سمت هر شخص را یک‌بار ثبت کنید. سپس جایگاه امضا را به او وصل کنید. برای <strong>تحویل کالا از انبار</strong>، بخش و تحویل‌گیرنده را در صفحه <a asp-page="/Dispatch">ارسال کالا به بخش</a> تعریف کنید؛ اینجا فقط امضاهای چاپی اسناد مالی است.</p>
    <form method="post" asp-page-handler="Person" class="filters">
        <label>نام و نام خانوادگی<input name="name" maxlength="120" required></label>
        <label>درجه یا رتبه<input name="rank" maxlength="80" placeholder="مثلاً کارمند ۱۷ یا سرهنگ"></label>
        <label>سمت اداری<input name="position" maxlength="120" placeholder="مثلاً رئیس آماد"></label>
        <button type="submit" class="button primary">ثبت شخص</button>
    </form>
    <form method="post" asp-page-handler="Assign" class="filters">
        <label>جایگاه امضا<select name="role">@foreach (var (role,label) in Amadban.Pages.OrganizationModel.Roles) { <option value="@role">@label</option> }</select></label>
        <label>شخص<select name="person" required><option value="">انتخاب کنید</option>
            @foreach (var person in Model.People) { <option value="@person.Id">@person.Rank @person.Name · @person.Position @(person.Department is null ? "" : "· " + person.Department)</option> }
        </select></label>
        <button type="submit" class="button primary">قرار دادن در برگه‌های چاپی</button>
    </form>
    <details><summary>ثبت مستقیم نام چاپی، در صورت نیاز</summary>
    <form method="post" asp-page-handler="Signer" class="filters">
        <label>جایگاه<select name="role">@foreach (var (role,label) in Amadban.Pages.OrganizationModel.Roles) { <option value="@role">@label</option> }</select></label>
        <label>نام و سمت<input name="name" maxlength="120"></label>
        <button type="submit" class="button primary">ذخیره نام</button>
    </form>
    </details>
    <div class="table-wrap"><table><thead><tr><th>جایگاه</th><th>نام چاپی</th></tr></thead><tbody>
    @foreach (var (role,label) in Amadban.Pages.OrganizationModel.Roles)
    { <tr><td>@label</td><td>@(Model.Signers.GetValueOrDefault(role) ?? "—")</td></tr> }
    </tbody></table></div>
    <details><summary>اصلاح نام، درجه یا سمت اشخاص</summary>
        <p>اصلاح هر شخص در چاپ‌های بعدی همه فرم‌هایی که او در آن‌ها انتخاب شده اعمال می‌شود.</p>
        @foreach (var person in Model.People)
        { <details><summary>@person.Rank @person.Name · @person.Position</summary>
            <form method="post" asp-page-handler="CorrectPerson" class="filters"><input type="hidden" name="id" value="@person.Id">
                <label>نام<input name="name" value="@person.Name" required maxlength="120"></label>
                <label>درجه یا رتبه<input name="rank" value="@person.Rank" maxlength="80"></label>
                <label>سمت<input name="position" value="@person.Position" maxlength="120"></label>
                <label>بخش (برای تحویل انبار)<select name="department">
                    <option value="0" selected="@(person.DepartmentId is null or 0)">بدون بخش — فقط امضای چاپی</option>
                    @foreach (var department in Model.Departments) { <option value="@department.Id" selected="@(person.DepartmentId == department.Id)">@department.Name</option> }
                </select></label>
                <button class="button" type="submit">ذخیره اصلاح</button>
            </form></details> }
    </details>
</section>
