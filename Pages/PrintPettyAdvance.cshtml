@page
@model Amadban.Pages.PrintPettyAdvanceModel
@inject Store Store
@{ Layout=null; var signers=await Store.SignerIdentitiesAsync(); var a=Model.Advance;
    var official=new OfficialPrepaymentPrint(a.Number,a.InvoiceNumber.ToString(),Persian.Date(a.Date),
        "","افسر عاملی",a.Description,a.Sheba,a.Bank,a.Owner,a.Amount,null,a.State,signers,true,"readable","","",0); }
<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><title>پیش‌پرداخت تنخواه @a.Number · آمادبان</title>
<link rel="stylesheet" href="~/print.css" asp-append-version="true"><link rel="stylesheet" href="~/portrait.css" asp-append-version="true"><link rel="stylesheet" href="~/official-print.css" asp-append-version="true">
<script src="~/site.js" asp-append-version="true" defer></script></head><body>
<nav class="print-controls"><label>تعداد نسخه <input type="number" data-print-copies min="1" max="12" value="1"></label>
    <button type="button" data-print>چاپ پیش‌پرداخت تنخواه A4</button><a asp-page="/Petty">بازگشت به تنخواه</a></nav>
@await Html.PartialAsync("_OfficialPrepayment",official)</body></html>
