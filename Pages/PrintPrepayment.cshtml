@page "{number:long}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "agent,chief")]
@inject Store Store
@using System.Security.Claims
@{
    Layout = null;
    var number = long.Parse(RouteData.Values["number"]!.ToString()!);
    var payment = await Store.ReadPrepaymentAsync(number, false);
    if (payment is null)
    {
        Response.StatusCode = 404;
        return;
    }
    var template = Request.Query["template"].ToString();
    if (!Amadban.Pages.PrintSettingsModel.Prepayments.ContainsKey(template))
        template = await Store.PrintPreferenceAsync(long.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier)!), "prepayment") ?? "readable";
    var signers = await Store.SignersAsync();
    var supplier = await Store.SupplierByNameAsync(payment.Vendor);
    var confirmation = supplier is not null
        && (await Store.SupplierDocumentsAsync(supplier.Id)).Any(file => file.Kind == "account");
    var linked = payment.Invoice is long invoice ? await Store.DetailAsync(invoice) : null;
    var document = linked?.Summary.Document;
    var first = linked?.Lines.FirstOrDefault()?.Title;
    var last = linked?.Lines.LastOrDefault()?.Title;
    var purpose = first is null ? (payment.Proforma ?? "—") : first == last ? first : first + " - " + last;
    var payee = supplier?.Kind == "person" && payment.Owner != payment.Vendor
        ? payment.Owner + " (" + payment.Vendor + ")" : payment.Owner;
}
<!doctype html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8">
    <title>پیش‌پرداخت @payment.Number · آمادبان</title>
    <link rel="stylesheet" href="~/print.css" asp-append-version="true">
    <link rel="stylesheet" href="~/portrait.css" asp-append-version="true">
    <script src="~/site.js" asp-append-version="true" defer></script>
</head>
<body>
<nav class="print-controls">
    <label>تعداد نسخه <input type="number" data-print-copies min="1" max="12" value="1"></label>
    <button type="button" data-print>چاپ پیش‌پرداخت A4</button><a asp-page="/Credit" asp-route-number="@number">بازگشت</a>
    @if (confirmation && supplier is not null)
    {
        <a asp-page="/Suppliers" asp-page-handler="Document" asp-route-id="@supplier.Id" asp-route-kind="account" asp-route-preview="true" target="_blank" rel="noopener">باز کردن تأییدیه حساب برای چاپ</a>
    }
    <form method="get"><label>قالب <select name="template">@foreach (var (key, title) in Amadban.Pages.PrintSettingsModel.Prepayments)
    { <option value="@key" selected="@(key==template)">@title</option> }</select></label><button type="submit">انتخاب</button></form>
    <form method="post" asp-page="/PrintSettings"><input type="hidden" name="form" value="prepayment"><input type="hidden" name="id" value="@number">
        <input type="hidden" name="template" value="@template"><button type="submit">تنظیم به‌عنوان پیش‌فرض</button></form>
</nav>
<article>
    <header>@await Html.PartialAsync("_BrandMarks", true)<p>بسمه‌تعالی</p><h1>پیش‌پرداخت</h1><p>بیمارستان امام سجاد (ع) فراجا</p></header>
    <p>با احترام، خواهشمند است مقرر فرمایید مدیریت مالی برابر اطلاعات و مجوز درج‌شده در این برگه برای صدور وجه اقدام کند.</p>
    <section class="metadata">
        <span>شماره پیش‌پرداخت <b>@payment.Number</b></span>
        <span>شماره سند <b>@(document?.ToString() ?? "—")</b></span>
        <span>تاریخ فاکتور <b>@(linked is null ? "—" : Persian.Date(linked.Summary.Date))</b></span>
        <span>شماره فاکتور <b>@(linked?.Summary.Number ?? payment.Proforma ?? "—")</b></span>
    </section>
    <table>
        <tbody>
            <tr><th>کد ردیف اعتباری</th><td>@payment.Code</td></tr>
            <tr><th>برنامه / طرح</th><td>@payment.CodeTitle</td></tr>
            <tr><th>بابت</th><td>@purpose</td></tr>
            <tr><th>دروجه شماره شبا</th><td><bdi>@payment.Sheba</bdi></td></tr>
            <tr><th>بانک</th><td>@payment.Bank</td></tr>
            <tr><th>به نام</th><td>@payee</td></tr>
            @if (template == "permit") { <tr><th>شماره و تاریخ مجوز</th><td>@payment.Permit · @payment.PermitDate</td></tr> }
            @if (template == "tax") { <tr><th>مالیات</th><td>@Persian.Money(payment.Tax) ریال</td></tr> }
            <tr><th>مبلغ</th><td>@Persian.Money(linked?.Summary.Total ?? payment.Amount) ریال</td></tr>
            <tr><th>مبلغ به حروف</th><td>@PersianWords.Number(linked?.Summary.Total ?? payment.Amount) ریال</td></tr>
            @if (payment.State == "void") { <tr><th>وضعیت</th><td>باطل‌شده</td></tr> }
        </tbody>
    </table>
    <p>پرداخت مبلغ درج‌شده با آگاهی و دستور مقام مجاز انجام می‌شود. مبلغ از محل اعتبارات مربوط قابل پرداخت است.</p>
    <section class="signatures"><div>تقاضای هزینه<p>@signers.GetValueOrDefault("petty_authorizer")</p></div>
        <div>گواهی مقام مجاز<p>@signers.GetValueOrDefault("chief")</p></div></section>
    <section class="signatures"><div>عامل ذی‌حساب<p>@signers.GetValueOrDefault("finance")</p></div>
        <div>اعتبارات<p>@signers.GetValueOrDefault("credit_officer")</p></div>
        <div>حسابداری<p>@signers.GetValueOrDefault("accounting")</p></div></section>
    <section class="prepayment-declaration"><h2>حواله وجه</h2><p>مبلغ فوق طبق چک شماره ..................... در وجه ..................... حواله یا پرداخت شد.</p>
        <h2>گواهی دریافت و تعهد افسرعامل</h2><p>متعهد می‌شوم وجه دریافت‌شده برابر قوانین و مقررات مربوط هزینه و اسناد آن را تحویل دهم.</p>
        <p>نام، درجه/رتبه و امضای افسرعامل: @signers.GetValueOrDefault("agent")</p></section>
</article>
</body>
</html>
