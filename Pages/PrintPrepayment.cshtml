@page "{number:long}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "agent,chief")]
@inject Store Store
@using System.Security.Claims
@{
    Layout = null;
    var number = long.Parse(RouteData.Values["number"]!.ToString()!);
    var payment = await Store.ReadPrepaymentAsync(number, false);
    if (payment is null)
    {
        Response.StatusCode = 404;
        return;
    }
    var template = Request.Query["template"].ToString();
    if (!Amadban.Pages.PrintSettingsModel.Prepayments.ContainsKey(template))
        template = await Store.PrintPreferenceAsync(long.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier)!), "prepayment") ?? "readable";
    var signers = await Store.SignerIdentitiesAsync();
    var supplier = await Store.SupplierByNameAsync(payment.Vendor);
    var confirmation = supplier is not null
        && (await Store.SupplierDocumentsAsync(supplier.Id)).Any(file => file.Kind == "account");
    var linked = payment.Invoice is long invoice ? await Store.DetailAsync(invoice) : null;
    var document = linked?.Summary.Document;
    var first = linked?.Lines.FirstOrDefault()?.Title;
    var last = linked?.Lines.LastOrDefault()?.Title;
    var purpose = first is null ? (payment.Proforma ?? "—") : first == last ? first : first + " - " + last;
    var payee = supplier?.Kind == "person" && payment.Owner != payment.Vendor
        ? payment.Owner + " (" + payment.Vendor + ")" : payment.Owner;
    var official = new OfficialPrepaymentPrint(payment.Number, linked?.Summary.Number ?? payment.Proforma ?? "",
        linked is null ? Persian.Date(DateOnly.FromDateTime(payment.CreatedAt)) : Persian.Date(linked.Summary.Date),
        payment.Code,payment.CodeTitle,purpose,payment.Sheba,payment.Bank,payee,
        linked?.Summary.Total ?? payment.Amount,document,payment.State,signers,false,template,
        payment.Permit,payment.PermitDate,payment.Tax);
}
<!doctype html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8">
    <title>پیش‌پرداخت @payment.Number · آمادبان</title>
    <link rel="stylesheet" href="~/print.css" asp-append-version="true">
    <link rel="stylesheet" href="~/portrait.css" asp-append-version="true">
    <link rel="stylesheet" href="~/official-print.css" asp-append-version="true">
    <script src="~/site.js" asp-append-version="true" defer></script>
</head>
<body>
<nav class="print-controls">
    <label>تعداد نسخه <input type="number" data-print-copies min="1" max="12" value="1"></label>
    <button type="button" data-print>چاپ پیش‌پرداخت A4</button><a asp-page="/Credit" asp-route-number="@number">بازگشت</a>
    @if (confirmation && supplier is not null)
    {
        <a asp-page="/Suppliers" asp-page-handler="Document" asp-route-id="@supplier.Id" asp-route-kind="account" asp-route-preview="true" target="_blank" rel="noopener">باز کردن تأییدیه حساب برای چاپ</a>
    }
    <form method="get"><label>قالب <select name="template">@foreach (var (key, title) in Amadban.Pages.PrintSettingsModel.Prepayments)
    { <option value="@key" selected="@(key==template)">@title</option> }</select></label><button type="submit">انتخاب</button></form>
    <form method="post" asp-page="/PrintSettings"><input type="hidden" name="form" value="prepayment"><input type="hidden" name="id" value="@number">
        <input type="hidden" name="template" value="@template"><button type="submit">تنظیم به‌عنوان پیش‌فرض</button></form>
</nav>
@await Html.PartialAsync("_OfficialPrepayment",official)
</body>
</html>
