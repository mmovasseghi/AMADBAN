@inject Store BrandStore
@{
    var marks = await BrandStore.BrandNamesAsync();
}
@if (marks.Count > 0)
{
    <div class="brand-marks">
        @if (marks.Contains("faraja")) { <img src="/BrandAsset/faraja" alt="نشان فراجا" width="28" height="40"> }
        @if (marks.Contains("health")) { <img src="/BrandAsset/health" alt="نشان معاونت بهداشت، امداد و درمان" width="32" height="40"> }
    </div>
}
