@{
    var page = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
}
@switch (page)
{
    case "/Index":
        <partial name="_EasyGuide" />
        break;
    case "/Invoices/New":
        <section class="easy-guide card" aria-label="راهنما">
            <h2>ثبت فاکتور — سه قدم</h2>
            <ol class="easy-steps">
                <li>شماره، تاریخ و نام فروشنده را <strong>عین برگه</strong> بنویسید.</li>
                <li>اگر جنس فیزیکی به انبار می‌رود، تیک <strong>ورود به انبار</strong> را بزنید.</li>
                <li>هر ردیف کالا را جدا بنویسید و پایین صفحه دکمهٔ سبز <strong>ثبت</strong> را بزنید.</li>
            </ol>
        </section>
        break;
    case "/Dispatch":
        <section class="easy-guide card" aria-label="راهنما">
            <h2>دادن کالا به بخش — سه قدم</h2>
            <ol class="easy-steps">
                <li><strong>بخش</strong> و <strong>شخص تحویل‌گیرنده</strong> را از لیست انتخاب کنید.</li>
                <li>نام یا کد کالا را بنویسید و <strong>تعداد</strong> را بزنید.</li>
                <li>دکمهٔ سبز <strong>ثبت خروج و چاپ برگه</strong> — برگه را برای امضا بدهید.</li>
            </ol>
        </section>
        break;
    case "/Stock":
        <section class="easy-guide card" aria-label="راهنما">
            <h2>موجودی انبار</h2>
            <ol class="easy-steps">
                <li>افزودن موجودی از <strong>فاکتور</strong> (صفحهٔ همان پرونده) انجام می‌شود، نه اینجا.</li>
                <li>اینجا فقط <strong>جست‌وجو</strong> کنید یا یک‌بار <strong>کالای جدید</strong> تعریف کنید.</li>
                <li>برای دادن کالا به بخش از منو <a asp-page="/Dispatch">ارسال کالا به بخش</a> استفاده کنید.</li>
            </ol>
        </section>
        break;
    case "/Departments":
        <section class="easy-guide card" aria-label="راهنما">
            <h2>نام بخش‌های بیمارستان</h2>
            <ol class="easy-steps">
                <li>اول <strong>نام بخش</strong> (مثلاً اورژانس) را ثبت کنید.</li>
                <li>بعد برای همان بخش <strong>نام شخص</strong> (تحویل‌گیرنده / مسئول) را ثبت کنید.</li>
                <li>همین نام‌ها در سند خرید و حوالهٔ انبار خودکار می‌آیند.</li>
            </ol>
        </section>
        break;
    case "/KardexQueue":
        <section class="easy-guide card" aria-label="راهنما">
            <h2>ثبت کارتکس</h2>
            <ol class="easy-steps">
                <li>بعد از ثبت در سامانهٔ فراجا، <strong>همان شماره</strong> را در جدول زیر بنویسید.</li>
                <li>تاریخ امروز معمولاً درست است؛ دکمهٔ سبز <strong>ثبت شد</strong> را بزنید.</li>
            </ol>
        </section>
        break;
    case "/Suppliers":
        <section class="easy-guide card" aria-label="راهنما">
            <h2>فروشنده</h2>
            <p class="easy-steps">نام فروشنده را یک‌بار اینجا بنویسید و <strong>ذخیره</strong> بزنید. در ثبت فاکتور بعدی همان نام پیشنهاد می‌شود.</p>
        </section>
        break;
    case "/Bank":
        <section class="easy-guide card" aria-label="راهنما">
            <h2>چک و فرم صیاد</h2>
            <p class="easy-steps">فیلدها را پر کنید و فقط دکمهٔ <strong>چاپ</strong> را بزنید. پیش‌نویس خودکار پاک می‌شود.</p>
        </section>
        break;
    case "/WarehouseReport":
        <section class="easy-guide card" aria-label="راهنما">
            <h2>گزارش تحویل</h2>
            <p class="easy-steps">تاریخ را بنویسید و دکمهٔ <strong>نمایش</strong> را بزنید.</p>
        </section>
        break;
    case "/Petty":
        <section class="easy-guide card" aria-label="راهنما">
            <h2>تنخواه</h2>
            <p class="easy-steps">ابتدا افسرعامل را انتخاب کنید؛ بعد از جدول، دریافت یا خرج را با دکمهٔ سبز ثبت کنید.</p>
        </section>
        break;
    case "/Credit":
        <section class="easy-guide card" aria-label="راهنما">
            <h2>پیش‌پرداخت</h2>
            <p class="easy-steps">پرونده را از لیست باز کنید یا جست‌وجو کنید؛ مبلغ و تاریخ را بنویسید و <strong>ثبت</strong> بزنید.</p>
        </section>
        break;
    case "/TaxBatch":
        <section class="easy-guide card" aria-label="راهنما">
            <h2>مالیات چند سند</h2>
            <p class="easy-steps">سندهای جدول را تیک بزنید، یک بار برگهٔ مالیات را بارگذاری کنید و <strong>ثبت گروهی</strong> را بزنید.</p>
        </section>
        break;
    case "/Staff":
        @if (User.IsInRole("chief"))
        {
            <section class="easy-guide card" aria-label="راهنما">
                <h2>کاربران</h2>
                <p class="easy-steps">برای هر نفر <strong>نام کاربری</strong> و <strong>رمز</strong> بدهید و نقش را انتخاب کنید؛ دکمهٔ سبز <strong>افزودن</strong>.</p>
            </section>
        }
        break;
}