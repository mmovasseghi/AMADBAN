@using Amadban.Pages
@{
    var page = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    EasyGuidePanel? panel = page switch
    {
        "/Index" => null,
        "/Invoices/New" => new("file-text", "ثبت فاکتور", "سه قدم ساده",
            "همان چیزی که روی برگهٔ فاکتور می‌بینید را اینجا بنویسید.",
            [
                new("مشخصات روی برگه", "شماره فاکتور، تاریخ شمسی و نام فروشنده."),
                new("ورود به انبار", "اگر جنس فیزیکی است، تیک <strong>ورود به انبار</strong> را بزنید؛ وگرنه خالی بگذارید."),
                new("اقلام و ثبت", "هر کالا یک ردیف؛ پایین صفحه دکمهٔ سبز <strong>ثبت</strong> را یک‌بار بزنید.")
            ]),
        "/Dispatch" => new("folder", "انبار", "دادن کالا به بخش",
            "برای تحویل کالا به بخش بیمارستان از بالا به پایین پیش بروید.",
            [
                new("بخش و شخص", "از لیست، <strong>بخش مقصد</strong> و <strong>تحویل‌گیرنده</strong> را انتخاب کنید."),
                new("کالا و تعداد", "نام یا کد کالا را بنویسید؛ تعداد را وارد کنید."),
                new("چاپ برگه", "دکمهٔ سبز <strong>ثبت خروج و چاپ برگه</strong> — برگه را امضا کنید.")
            ]),
        "/Stock" => new("bag", "انبار", "موجودی چطور عوض می‌شود؟",
            "اینجا بیشتر برای <strong>دیدن مانده</strong> است؛ افزایش موجودی از فاکتور انجام می‌شود.",
            [
                new("افزودن از فاکتور", "داخل پروندهٔ خرید، بخش <strong>ورود اقلام به انبار</strong> را بزنید — نه این صفحه."),
                new("جست‌وجو یا تعریف کالا", "نام کالا را جست‌وجو کنید، یا یک‌بار کالای جدید با کد ثبت کنید."),
                new("دادن به بخش", null, "/Dispatch", "ارسال کالا به بخش")
            ]),
        "/Departments" => new("folder", "پایه‌دهی", "بخش‌ها و مسئولین",
            "یک‌بار ثبت می‌کنید؛ بعد در فاکتور و حواله از لیست انتخاب می‌شود.",
            [
                new("نام بخش", "مثلاً اورژانس، اتاق عمل — دکمهٔ ثبت بخش."),
                new("نام شخص", "برای همان بخش، نام مسئول یا تحویل‌گیرنده را ثبت کنید."),
                new("استفاده در کار روزانه", "همان نام‌ها در سند خرید و حوالهٔ انبار ظاهر می‌شوند.")
            ]),
        "/KardexQueue" => new("notebook", "کارتکس", "ثبت شماره روی سند",
            "اول در سامانهٔ فراجا ثبت کنید؛ بعد همان شماره را اینجا بنویسید.",
            [
                new("شماره را بنویسید", "در جدول پایین، ستون شماره — عین آنچه روی سند چاپ شده."),
                new("ثبت شد", "تاریخ امروز معمولاً درست است؛ دکمهٔ سبز <strong>ثبت شد</strong>.")
            ]),
        "/Suppliers" => new("boy", "فروشنده", "ثبت یک‌بار، استفاده همیشه",
            "نام فروشنده را ذخیره کنید تا در فاکتورهای بعد پیشنهاد شود.",
            [new("اطلاعات و ذخیره", "نام فروشنده را بنویسید و دکمهٔ <strong>ذخیره اطلاعات</strong> را بزنید.")]),
        "/Bank" => new("card", "بانک", "چک و فرم صیاد",
            "فیلدها را پر کنید؛ برای چاپ فقط دکمهٔ چاپ را بزنید.",
            [new("پر کردن و چاپ", "پیش‌نویس بعد از چاپ خودکار پاک می‌شود.")]),
        "/WarehouseReport" => new("chart", "انبار", "گزارش تحویل",
            null,
            [new("تاریخ و نمایش", "از تاریخ و تا تاریخ را بنویسید؛ دکمهٔ <strong>نمایش</strong>.")]),
        "/Petty" => new("wallet", "تنخواه", "دریافت و خرج",
            "اول افسرعامل را انتخاب کنید.",
            [new("ثبت در جدول", "دریافت یا خرید را با دکمهٔ سبز پایین فرم ثبت کنید.")]),
        "/Credit" => new("money-bag", "اعتبار", "پیش‌پرداخت",
            null,
            [new("پرونده را باز کنید", "از لیست یا جست‌وجو؛ مبلغ و تاریخ؛ دکمهٔ <strong>ثبت</strong>.")]),
        "/TaxBatch" => new("folder", "مالیات", "چند سند با یک برگه",
            null,
            [new("تیک و بارگذاری", "سندها را تیک بزنید، برگهٔ مالیات را بارگذاری کنید، <strong>ثبت گروهی</strong>.")]),
        "/Staff" => User.IsInRole("chief")
            ? new("key", "مدیر", "کاربر جدید",
                "برای هر نفر یک نام کاربری و رمز ساده بدهید.",
                [new("نقش و افزودن", "نام کاربری، رمز، نقش (انباردار، مأمور، کارتکس…)؛ دکمهٔ سبز <strong>افزودن</strong>.")])
            : null,
        _ => null
    };
}
@if (page == "/Index")
{
    <partial name="_EasyGuide" />
}
else if (panel is not null)
{
    <partial name="_EasyPanel" model="panel" />
}