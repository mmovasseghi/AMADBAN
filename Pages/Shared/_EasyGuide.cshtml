@{
    var page = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    string title, tag;
    var steps = new List<(string Bold, string Text, string? Page, string? Link)>();
    if (User.IsInRole("warehouse") && !User.IsInRole("chief"))
    {
        title = "راهنمای کوتاه"; tag = "انباردار";
        steps.Add(("پرونده با سند", "کارتابل → باز کردن پرونده", "/Index", "کارتابل"));
        steps.Add(("ورود موجودی", "در پرونده: ثبت ورود اقلام فاکتور", null, null));
        steps.Add(("تحویل به بخش", "ارسال کالا به بخش", "/Dispatch", "حواله"));
    }
    else if (User.IsInRole("kardex") && !User.IsInRole("chief"))
    {
        title = "راهنمای کوتاه"; tag = "کارتکس";
        steps.Add(("ثبت در فراجا", "بعد همان شماره را اینجا بنویسید", "/KardexQueue", "ثبت کارتکس"));
        steps.Add(("پیدا کردن پرونده", "اگر در لیست نبود: صفحهٔ اصلی", "/Index", "صفحهٔ اصلی"));
    }
    else if (User.IsInRole("agent") && !User.IsInRole("chief"))
    {
        title = "راهنمای کوتاه"; tag = "مأمور خرید";
        steps.Add(("ثبت فاکتور", "منو: ثبت فاکتور — فرم را پر کنید — دکمهٔ سبز پایین", "/Invoices/New", "ثبت فاکتور"));
        steps.Add(("پیش‌پرداخت", "صفحهٔ اصلی → باز کردن پرونده → دکمهٔ سبز پیش‌پرداخت → چاپ", "/Index", "صفحهٔ اصلی"));
        steps.Add(("پیگیری", "صفحهٔ اصلی → دکمه «باز کردن پرونده»", "/Index", "صفحهٔ اصلی"));
    }
    else if (User.IsInRole("chief"))
    {
        title = "راهنمای کوتاه"; tag = "رئیس آماد";
        steps.Add(("کار فوری", "روی کارت‌های رنگی پایین همین صفحه بزنید", null, null));
        steps.Add(("خرید", "ثبت فاکتور یا باز کردن پرونده از جدول", "/Invoices/New", "ثبت فاکتور"));
        steps.Add(("تنظیمات", "در منو: بخش‌ها، فروشندگان، کاربران", "/Departments", "بخش‌ها"));
    }
    else
    {
        title = "راهنمای کوتاه"; tag = "کاربر";
        steps.Add(("پرونده", "صفحهٔ اصلی → کلیک روی سطر", "/Index", "صفحهٔ اصلی"));
    }
}
<section class="role-guide card" aria-label="@title">
    <div class="role-guide-head"><span>@title</span><small>@tag</small></div>
    <ol>
        @foreach (var (bold, text, linkPage, linkText) in steps)
        {
            <li>
                <strong>@bold</strong> — @text
                @if (linkPage is not null)
                {
                    <a asp-page="@linkPage">@linkText</a>
                }
            </li>
        }
    </ol>
</section>