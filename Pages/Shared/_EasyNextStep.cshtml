@model IReadOnlyList<string>
@if (Model.Count > 0)
{
    <section class="easy-next card" role="status">
        <h2>قدم بعدی روی این پرونده</h2>
        <p>فقط <strong>اولین مورد</strong> را انجام دهید؛ بعد صفحه را یک‌بار تازه کنید (F5).</p>
        <p class="easy-next-action">@Model[0]</p>
        @if (Model.Count > 1)
        {
            <details class="easy-next-more">
                <summary>بعد از آن (@(Model.Count - 1) کار دیگر)</summary>
                <ul>@foreach (var item in Model.Skip(1)) { <li>@item</li> }</ul>
            </details>
        }
    </section>
}