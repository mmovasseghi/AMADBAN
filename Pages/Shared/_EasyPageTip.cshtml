@{
    var page = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    string? tip = page switch
    {
        "/Invoices/New" => "از بالا به پایین پر کنید. آخر کار فقط یک‌بار دکمهٔ سبز «ذخیره فاکتور» را بزنید.",
        "/Invoices/Detail" => "مهم‌ترین کارها بالای صفحه است (دکمهٔ سبز). بقیهٔ بخش‌ها برای تکمیل پرونده است.",
        "/Credit" => Model is Amadban.Pages.CreditModel cm && (cm.Invoice is not null || cm.Payment is not null)
            ? "فرم را پر کنید و «ثبت و چاپ برگه A4» را بزنید."
            : "برای پیش‌پرداخت سند، از صفحهٔ اصلی پرونده را باز کنید — نه شمارهٔ دستی.",
        "/Bank" => "اول چک را در فرم بالا ثبت کنید. برای چاپ، در جدول تیک بزنید و دکمهٔ چاپ را بزنید.",
        "/Petty" => "دریافت تنخواه را در فرم بالا ثبت کنید. گزارش پایین فقط برای دیدن است.",
        "/Stock" => "برای دیدن گردش یک کالا، در جدول روی «گردش» بزنید. افزودن از فاکتور انجام می‌شود.",
        "/Dispatch" => "۱ بخش را انتخاب کنید ۲ کالا بنویسید ۳ دکمهٔ سبز پایین را بزنید.",
        "/TaxBatch" => "اول تاریخ را بزنید و سندها را ببینید. بعد تیک بزنید و فایل برگه را بارگذاری کنید.",
        "/Suppliers" => "هر فروشنده یک‌بار ثبت می‌شود؛ بعد در فاکتور نامش پیشنهاد می‌شود.",
        "/Departments" => "نام بخش و مسئول را ثبت کنید — در فاکتور و حوالهٔ انبار استفاده می‌شود.",
        "/KardexQueue" => "شمارهٔ روی سند فراجا را در جعبهٔ همان ردیف بنویسید و دکمهٔ سبز «ثبت شد» را بزنید.",
        "/WarehouseReport" => "تاریخ را بنویسید و «نمایش» را بزنید؛ جدول فقط برای دیدن است.",
        "/Analytics" => "بازه تاریخ را بنویسید و نمایش را بزنید — نیاز به تغییر دستی جدول نیست.",
        "/Activity" => "روی هر اطلاعیه کلیک کنید تا جزئیات باز شود.",
        "/Organization" => "نام و سمت امضاکننده را یک‌بار ثبت کنید؛ در چاپ‌ها خودکار می‌آید.",
        "/Staff" => "فقط رئیس آماد کاربر جدید می‌سازد؛ نام کاربری و رمز را به همکار بدهید.",
        _ => null
    };
}
@if (tip is not null)
{
    <p class="page-tip notice" role="status"><strong>راهنمای این صفحه:</strong> @tip</p>
}