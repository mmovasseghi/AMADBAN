@model EasyGuidePanel
<details class="easy-hint card" @(Model.PinnedOpen ? "open" : null)>
    <summary class="easy-hint-summary">
        <span class="easy-hint-title">@Model.Title</span>
        @if (!string.IsNullOrWhiteSpace(Model.Eyebrow))
        {
            <span class="easy-hint-tag">@Model.Eyebrow</span>
        }
    </summary>
    @if (!string.IsNullOrWhiteSpace(Model.Lead))
    {
        <p class="easy-hint-lead">@Model.Lead</p>
    }
    <ol class="easy-hint-steps">
        @foreach (var step in Model.Steps)
        {
            <li>
                <strong>@step.Title</strong>
                @if (!string.IsNullOrWhiteSpace(step.Detail))
                {
                    <span> — @Html.Raw(step.Detail)</span>
                }
                @if (!string.IsNullOrWhiteSpace(step.Page))
                {
                    <a class="easy-hint-link" asp-page="@step.Page">@(step.LinkText ?? "برو")</a>
                }
            </li>
        }
    </ol>
</details>