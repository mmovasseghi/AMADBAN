<!doctype html>
@inject Store ActivityStore
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <link rel="icon" href="/amadban-mark.svg" type="image/svg+xml">
    <title>@ViewData["Title"] · آمادبان</title>
    <link rel="stylesheet" href="~/site.css" asp-append-version="true">
    <script src="~/site.js" asp-append-version="true" defer></script>
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    var activePage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var unreadActivity = User.IsInRole("chief")
        ? await ActivityStore.UnreadActivityAsync(long.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value))
        : 0;
    <div class="app">
        <aside class="sidebar">
            <a class="brand" asp-page="/Index" aria-label="آمادبان، صفحه اصلی">
                <span class="brand-icon"><img src="/amadban-mark.svg" width="50" height="50" alt=""></span>
                <span><b>آمادبان</b><small>خرید · انبار · پیگیری</small></span>
            </a>
            <nav aria-label="منو">
                <span class="menu-caption">کارهای اصلی</span>
                <a class="@(activePage == "/Index" && !Context.Request.Query.ContainsKey("Report") ? "active" : "")" asp-page="/Index"><img class="menu-icon" src="/icon3d/cube.webp" width="30" height="30" alt=""> صفحهٔ اصلی</a>
                @if (User.IsInRole("agent") || User.IsInRole("chief"))
                {
                    <a class="@(activePage == "/Invoices/New" ? "active" : "")" asp-page="/Invoices/New"><img class="menu-icon" src="/icon3d/file-text.webp" width="30" height="30" alt=""> ثبت فاکتور</a>
                }
                @if (User.IsInRole("warehouse") || User.IsInRole("chief"))
                {
                    <a class="@(activePage == "/Stock" ? "active" : "")" asp-page="/Stock"><img class="menu-icon" src="/icon3d/bag.webp" width="30" height="30" alt=""> موجودی انبار</a>
                    <a class="@(activePage == "/Dispatch" ? "active" : "")" asp-page="/Dispatch"><img class="menu-icon" src="/icon3d/folder.webp" width="30" height="30" alt=""> ارسال کالا به بخش</a>
                    <a class="@(activePage == "/WarehouseReport" ? "active" : "")" asp-page="/WarehouseReport"><img class="menu-icon" src="/icon3d/chart.webp" width="30" height="30" alt=""> گزارش تحویل انبار</a>
                }
                @if (User.IsInRole("kardex") || User.IsInRole("chief"))
                { <a class="@(activePage == "/KardexQueue" ? "active" : "")" asp-page="/KardexQueue"><img class="menu-icon" src="/icon3d/notebook.webp" width="30" height="30" alt=""> ثبت سریع کارتکس</a> }
                else if (User.IsInRole("agent"))
                { <a asp-page="/Index" asp-route-Status="kardex"><img class="menu-icon" src="/icon3d/notebook.webp" width="30" height="30" alt=""> پیگیری کارتکس</a> }
                @if (User.IsInRole("chief") || User.IsInRole("agent") || User.IsInRole("warehouse"))
                {
                    <a class="@(activePage == "/Departments" ? "active" : "")" asp-page="/Departments"><img class="menu-icon" src="/icon3d/folder.webp" width="30" height="30" alt=""> نام بخش‌های بیمارستان</a>
                }
                @if (User.IsInRole("chief") || User.IsInRole("agent"))
                {
                <details class="menu-more">
                    <summary><img class="menu-icon" src="/icon3d/folder.webp" width="30" height="30" alt=""> گزارش‌ها و کارهای دیگر</summary>
                    <div class="menu-more-body">
                        <a class="@(activePage == "/Index" && Context.Request.Query.ContainsKey("Report") ? "active" : "")" asp-page="/Index" asp-route-Report="true"><img class="menu-icon" src="/icon3d/chart.webp" width="30" height="30" alt=""> گزارش فاکتورها</a>
                        <a class="@(activePage == "/Analytics" ? "active" : "")" asp-page="/Analytics"><img class="menu-icon" src="/icon3d/calculator.webp" width="30" height="30" alt=""> تحلیل خریدها</a>
                        @if (User.IsInRole("agent") || User.IsInRole("chief"))
                        {
                            <a class="@(activePage == "/Suppliers" ? "active" : "")" asp-page="/Suppliers"><img class="menu-icon" src="/icon3d/boy.webp" width="30" height="30" alt=""> فروشندگان</a>
                            <a class="@(activePage == "/Bank" ? "active" : "")" asp-page="/Bank"><img class="menu-icon" src="/icon3d/card.webp" width="30" height="30" alt=""> چک و فرم صیاد</a>
                            <a class="@(activePage == "/TaxBatch" ? "active" : "")" asp-page="/TaxBatch"><img class="menu-icon" src="/icon3d/folder.webp" width="30" height="30" alt=""> ثبت مالیات چند سند</a>
                            <a class="@(activePage == "/Petty" ? "active" : "")" asp-page="/Petty"><img class="menu-icon" src="/icon3d/wallet.webp" width="30" height="30" alt=""> تنخواه</a>
                            <a class="@(activePage == "/Credit" ? "active" : "")" asp-page="/Credit"><img class="menu-icon" src="/icon3d/money-bag.webp" width="30" height="30" alt=""> اعتبار و پیش‌پرداخت</a>
                        }
                        @if (User.IsInRole("chief"))
                        {
                            <a class="@(activePage == "/Activity" ? "active" : "")" asp-page="/Activity"><img class="menu-icon" src="/icon3d/megaphone.webp" width="30" height="30" alt=""> اطلاعیه‌های آماد
                                @if (unreadActivity>0) { <span class="notification-pill">@(unreadActivity>99 ? "۹۹+" : unreadActivity.ToString())</span> }
                            </a>
                            <a class="@(activePage == "/Organization" ? "active" : "")" asp-page="/Organization"><img class="menu-icon" src="/icon3d/setting.webp" width="30" height="30" alt=""> نشان و امضا</a>
                            <a class="@(activePage == "/Staff" ? "active" : "")" asp-page="/Staff"><img class="menu-icon" src="/icon3d/key.webp" width="30" height="30" alt=""> کاربران</a>
                        }
                    </div>
                </details>
                }
            </nav>
            <div class="org">سامانه داخلی آماد و پشتیبانی</div>
        </aside>
        <div class="workspace">
            <header class="toolbar">
                <div class="identity-strip"><div class="identity-logos"><img src="/BrandAsset/faraja" width="43" height="58" alt="نشان فراجا"><img src="/BrandAsset/health" width="52" height="58" alt="نشان معاونت بهداشت، امداد و درمان فراجا"></div>
                    <div><strong>بیمارستان فوق تخصصی امام سجاد (ع) فراجا</strong><small>دایره آماد و پشتیبانی · سامانه آمادبان</small></div></div>
                <div class="toolbar-actions">
                    @if (User.IsInRole("chief")) { <a class="toolbar-notify" asp-page="/Activity" aria-label="اطلاعیه‌های آماد"><img src="/icon3d/megaphone.webp" width="31" height="31" alt=""><span>اطلاعیه‌ها</span><b data-notification-badge hidden="@(unreadActivity==0)">@(unreadActivity>99 ? "۹۹+" : unreadActivity.ToString())</b></a> }
                    <span class="top-user"><img src="/icon3d/boy.webp" width="30" height="30" alt=""> @User.Identity.Name</span>
                    <button class="button easy-toggle quiet" type="button" data-simple-ui-toggle aria-pressed="false">متن بزرگ‌تر</button>
                    <form method="post" asp-page="/Logout"><button class="button quiet" type="submit">خروج</button></form></div>
            </header>
            <main id="content">
                @{
                    var contentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
                    var isPrint = contentPage.Contains("/Print", StringComparison.OrdinalIgnoreCase)
                        || contentPage is "/PrintBank" or "/PrintForms" or "/PrintSettings" or "/BrandAsset";
                }
                @if (!isPrint && contentPage is not "/Invoices/Detail") { <partial name="_EasyContext" /> }
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    <main class="guest">@RenderBody()</main>
}
</body>
</html>
