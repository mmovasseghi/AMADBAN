@page
@model Amadban.Pages.StockModel
@{
    ViewData["Title"] = "موجودی انبار";
}
<header class="hero"><div class="hero-main"><span class="hero-icon"><img src="/icon3d/bag.webp" width="82" height="82" alt=""></span><div><div class="eyebrow">انبار بیمارستان</div><h1>موجودی و گردش انبار</h1>
        <p>@(Model.CanEditStock
            ? "ورود عادی از فاکتور است. برای تغییر دستی (مثلاً موجودی سیب): کالا را جست‌وجو کنید و «گردش و ویرایش» را بزنید."
            : "ماندهٔ کالا را ببینید. افزودن موجودی از صفحهٔ فاکتور انجام می‌شود.")</p></div></div><a class="button primary" asp-page="/Dispatch">ارسال کالا به بخش</a></header>
@if (Model.Message is not null) { <p class="notice" role="status">@Model.Message</p> }
@if (!Model.CanEditStock)
{
    <p class="notice">مشاهدهٔ مانده و گردش برای انباردار است؛ <strong>اصلاح، ورود/خروج دستی و انبارگردانی</strong> فقط با حساب <strong>رئیس آماد</strong> انجام می‌شود. افزایش عادی موجودی از پروندهٔ فاکتور است.</p>
}
@if (Model.Selected is { } product)
{
    <section class="card">
        <h2>@product.Name · @product.Stock.ToString("0.###") @product.Unit</h2>
        <form method="get" class="filters">
            <input type="hidden" name="ProductId" value="@product.Id">
            <label>از تاریخ<input name="From" dir="ltr" value="@Model.From" placeholder="۱۴۰۵/۰۱/۰۱"></label>
            <label>تا تاریخ<input name="To" dir="ltr" value="@Model.To" placeholder="۱۴۰۵/۱۲/۲۹"></label>
            <button class="button" type="submit">نمایش گردش</button>
        </form>
        <div asp-validation-summary="All" class="validation"></div>
        <div class="table-wrap"><table><thead><tr><th>تاریخ</th><th>عملیات</th><th>تغییر موجودی</th><th>شمارش و مانده پیشین</th><th>بخش یا توضیح</th><th>ثبت‌کننده</th><th>پرونده</th></tr></thead>
        <tbody>@foreach (var entry in Model.History)
        {
            <tr><td>@Persian.Date(entry.Date)</td><td>@(entry.Kind == "opening" ? "شمارش افتتاحیه" : entry.Kind == "count" ? "انبارگردانی" : entry.Kind == "in" ? "ورود" : "خروج")</td><td>@entry.Delta.ToString("+0.###;-0.###;0")</td>
                <td>@(entry.Counted is decimal counted ? $"{counted:0.###} از {entry.Before:0.###}" : "—")</td><td>@(entry.Department ?? "—")</td><td>@entry.Actor</td>
                <td>@if (entry.Invoice is long id) { <a asp-page="/Invoices/Detail" asp-route-id="@id">مشاهده</a> }</td></tr>
        }</tbody></table></div>
        @if (Model.CanEditStock)
        {
            <div class="stock-chief-panel" id="edit-stock">
                <h3>ویرایش دستی موجودی — @product.Name</h3>
                <p class="form-note">ماندهٔ الان: <strong>@product.Stock.ToString("0.###") @product.Unit</strong>. برای اضافه یا کم کردن بدون فاکتور، نوع و مقدار را بنویسید و ثبت کنید.</p>
                <form method="post" asp-page-handler="Move" class="filters">
                    <input type="hidden" name="productId" value="@product.Id"><input type="hidden" name="submission" value="@Model.Submission">
                    <label>نوع<select name="kind"><option value="in">ورود (افزایش)</option><option value="out">خروج (کاهش)</option><option value="opening">شروع اولیه (فقط اگر هنوز گردشی نداشته)</option></select></label>
                    <label>مقدار<input name="quantity" inputmode="decimal" required placeholder="مثلاً ۱۰"></label>
                    <label>تاریخ شمسی<input name="date" dir="ltr" value="@Persian.Date(Persian.Today)" required></label>
                    <label>توضیح / بخش (اختیاری)<input name="department" maxlength="120" placeholder="دلیل یا نام بخش"></label>
                    <button class="button primary" type="submit">اعمال روی موجودی</button>
                </form>
            </div>
            <div class="stock-chief-panel">
                <h3>انبارگردانی — مانده را برابر شمارش واقعی کنید</h3>
                <p>اگر در انبار شمردید و عدد با سیستم فرق دارد، موجودی واقعی را بنویسید.</p>
                <form method="post" asp-page-handler="Count" class="filters">
                    <input type="hidden" name="productId" value="@product.Id"><input type="hidden" name="submission" value="@Model.Submission">
                    <label>موجودی واقعی شمارش‌شده<input name="counted" inputmode="decimal" required></label>
                    <label>تاریخ شمسی<input name="date" dir="ltr" value="@Persian.Date(Persian.Today)" required></label>
                    <label>یادداشت<input name="note" maxlength="120"></label>
                    <button class="button" type="submit">ثبت شمارش</button>
                </form>
            </div>
            <div class="stock-chief-panel">
                <h3>اصلاح نام، کد یا واحد کالا</h3>
                <form method="post" asp-page-handler="CorrectProduct" class="filters">
                    <input type="hidden" name="id" value="@product.Id">
                    <label>کد کالا<input name="code" value="@product.Code" required maxlength="40"></label>
                    <label>نام کالا<input name="name" value="@product.Name" required maxlength="150"></label>
                    <label>واحد<input name="unit" value="@product.Unit" required maxlength="30"></label>
                    <label>حداقل موجودی<input name="minimum" value="@product.Minimum" required inputmode="decimal"></label>
                    <button type="submit" class="button">ذخیره مشخصات</button>
                </form>
            </div>
        }
    </section>
}
<section class="card">
    <h2>کالاها</h2>
    <form method="get" class="filters">
        <label>نام یا کد کالا<input name="Search" value="@Model.Search"></label>
        <label class="inline"><input name="Low" value="true" type="checkbox" @(Model.Low ? "checked" : null)> کم‌موجودی</label>
        <button class="button" type="submit">جست‌وجو</button>
    </form>
    <div class="table-wrap"><table><thead><tr><th>شناسه کالا</th><th>نام</th><th>موجودی</th><th>حداقل</th><th>گردش</th></tr></thead><tbody>
      @foreach (var item in Model.Products.Take(25))
      {
          <tr><td>@item.Code</td><td>@item.Name</td><td>@item.Stock.ToString("0.###") @item.Unit</td><td>@item.Minimum.ToString("0.###")</td><td><a class="button" asp-route-ProductId="@item.Id" asp-route-Search="@Model.Search" asp-route-Low="@Model.Low">@(Model.CanEditStock ? "گردش و ویرایش" : "گردش")</a></td></tr>
      }
    </tbody></table></div>
    <nav class="pagination" aria-label="صفحه کالا">
        @if (Model.P > 1) { <a class="button" asp-route-P="@(Model.P - 1)" asp-route-Search="@Model.Search" asp-route-Low="@Model.Low">قبلی</a> }
        @if (Model.Products.Count > 25) { <a class="button" asp-route-P="@(Model.P + 1)" asp-route-Search="@Model.Search" asp-route-Low="@Model.Low">بعدی</a> }
    </nav>
    @if (Model.CanEditStock)
    {
        <form method="post" asp-page-handler="Product" class="filters">
            <label>کد کالای جدید<input name="code" required maxlength="40"></label>
            <label>نام<input name="name" required maxlength="150"></label>
            <label>واحد<input name="unit" value="عدد" required maxlength="30"></label>
            <label>حداقل موجودی<input name="minimum" value="0" required inputmode="decimal"></label>
            <button class="button primary" type="submit">تعریف کالا</button>
        </form>
    }
</section>
