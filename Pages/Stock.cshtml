@page
@model Amadban.Pages.StockModel
@{
    ViewData["Title"] = "موجودی انبار";
}
<header class="hero"><div><h1>موجودی و گردش انبار</h1><p>موجودی کالاها، ورود فاکتور و شمارش واقعی را اینجا ببینید.</p></div><a class="button primary" asp-page="/Dispatch">ارسال کالا به بخش</a></header>
@if (Model.Message is not null) { <p class="notice" role="status">@Model.Message</p> }
@if (Model.Selected is { } product)
{
    <section class="card">
        <h2>@product.Name · @product.Stock.ToString("0.###") @product.Unit</h2>
        <form method="post" asp-page-handler="Move" class="filters">
            <input type="hidden" name="productId" value="@product.Id"><input type="hidden" name="submission" value="@Model.Submission">
            <label>نوع گردش<select name="kind"><option value="in">ورود</option><option value="out">خروج</option><option value="opening">شمارش افتتاحیه</option></select></label>
            <label>مقدار<input name="quantity" inputmode="decimal" required><small>برای افتتاحیه، صفر نیز مجاز است.</small></label>
            <label>تاریخ شمسی<input name="date" dir="ltr" value="@Persian.Date(Persian.Today)" required></label>
            <label>بخش دریافت‌کننده<input name="department" maxlength="120"></label>
            <label>شناسه پرونده ورود، در صورت وجود<input name="invoice" type="number" min="1"></label>
            <button class="button primary" type="submit">ثبت گردش</button>
        </form>
        <details>
            <summary>ثبت شمارش واقعی و مغایرت انبارگردانی</summary>
            <p>موجودی فعلی @product.Stock.ToString("0.###") @product.Unit است. مقدار واقعی شمارش‌شده را وارد کنید؛ اختلاف در سابقه کالا ثبت می‌شود.</p>
            <form method="post" asp-page-handler="Count" class="filters">
                <input type="hidden" name="productId" value="@product.Id"><input type="hidden" name="submission" value="@Model.Submission">
                <label>موجودی واقعی<input name="counted" inputmode="decimal" required></label>
                <label>تاریخ شمسی<input name="date" dir="ltr" value="@Persian.Date(Persian.Today)" required></label>
                <label>یادداشت مغایرت، در صورت نیاز<input name="note" maxlength="120"></label>
                <button class="button primary" type="submit">ثبت شمارش</button>
            </form>
        </details>
        <form method="get" class="filters">
            <input type="hidden" name="ProductId" value="@product.Id">
            <label>از تاریخ<input name="From" dir="ltr" value="@Model.From" placeholder="۱۴۰۵/۰۱/۰۱"></label>
            <label>تا تاریخ<input name="To" dir="ltr" value="@Model.To" placeholder="۱۴۰۵/۱۲/۲۹"></label>
            <button class="button" type="submit">نمایش گردش</button>
        </form>
        <div asp-validation-summary="All" class="validation"></div>
        <div class="table-wrap"><table><thead><tr><th>تاریخ</th><th>عملیات</th><th>تغییر موجودی</th><th>شمارش و مانده پیشین</th><th>بخش یا توضیح</th><th>ثبت‌کننده</th><th>پرونده</th></tr></thead>
        <tbody>@foreach (var entry in Model.History)
        {
            <tr><td>@Persian.Date(entry.Date)</td><td>@(entry.Kind == "opening" ? "شمارش افتتاحیه" : entry.Kind == "count" ? "انبارگردانی" : entry.Kind == "in" ? "ورود" : "خروج")</td><td>@entry.Delta.ToString("+0.###;-0.###;0")</td>
                <td>@(entry.Counted is decimal counted ? $"{counted:0.###} از {entry.Before:0.###}" : "—")</td><td>@(entry.Department ?? "—")</td><td>@entry.Actor</td>
                <td>@if (entry.Invoice is long id) { <a asp-page="/Invoices/Detail" asp-route-id="@id">مشاهده</a> }</td></tr>
        }</tbody></table></div>
    </section>
}
<section class="card">
    <h2>کالاها</h2>
    <form method="get" class="filters">
        <label>نام یا کد کالا<input name="Search" value="@Model.Search"></label>
        <label class="inline"><input name="Low" value="true" type="checkbox" checked="@Model.Low"> کم‌موجودی</label>
        <button class="button" type="submit">جست‌وجو</button>
    </form>
    <div class="table-wrap"><table><thead><tr><th>شناسه کالا</th><th>نام</th><th>موجودی</th><th>حداقل</th><th>گردش</th></tr></thead><tbody>
      @foreach (var item in Model.Products.Take(25))
      {
          <tr><td>@item.Code</td><td>@item.Name</td><td>@item.Stock.ToString("0.###") @item.Unit</td><td>@item.Minimum.ToString("0.###")</td><td><a class="button quiet" asp-route-ProductId="@item.Id">گردش</a></td></tr>
      }
    </tbody></table></div>
    <nav class="pagination" aria-label="صفحه کالا">
        @if (Model.P > 1) { <a class="button" asp-route-P="@(Model.P - 1)" asp-route-Search="@Model.Search" asp-route-Low="@Model.Low">قبلی</a> }
        @if (Model.Products.Count > 25) { <a class="button" asp-route-P="@(Model.P + 1)" asp-route-Search="@Model.Search" asp-route-Low="@Model.Low">بعدی</a> }
    </nav>
    <form method="post" asp-page-handler="Product" class="filters">
        <label>کد کالای جدید<input name="code" required maxlength="40"></label>
        <label>نام<input name="name" required maxlength="150"></label>
        <label>واحد<input name="unit" value="عدد" required maxlength="30"></label>
        <label>حداقل موجودی<input name="minimum" value="0" required inputmode="decimal"></label>
        <button class="button primary" type="submit">تعریف کالا</button>
    </form>
</section>
